// new messages mod library
//
//
(msg_init func)
     (set string s modulemsgstr "libl1vmmsg")
     (set string s set_intmsgstr "msg_set_int64")
     (set string s set_doublemsgstr "msg_set_double")
     (set string s set_stringmsgstr "msg_set_string")
     (set string s searchidmsgstr "msg_search_id")
     (set string s get_intmsgstr "msg_get_int64")
     (set string s get_doublemsgstr "msg_get_double")
     (set string s get_stringmsgstr "msg_get_string")
     (set string s delete_msgstr "msg_delete")
     (set string s init_msgstr "msg_init")
     (set string s free_msgstr "msg_free_mem")
     (set string s get_type_msgstr "msg_get_type")
     (set int64 1 set_intmsg 0)
     (set int64 1 set_doublemsg 1)
     (set int64 1 set_stringmsg 2)
     (set int64 1 searchidmsg 3)
     (set int64 1 get_intmsg 4)
     (set int64 1 get_doublemsg 5)
     (set int64 1 get_stringmsg 6)
     (set int64 1 delete_msg 7)
     (set int64 1 init_msg 8)
     (set int64 1 free_msg 9)
     (set int64 1 get_type_msg 10)
     (set int64 1 modmsg 0)
     (set int64 1 maxmsg 0)

    // get argument from stack
    (maxmsg stpopi)
    (modmsg stpopi)
    // load string module
    (0 modulemsgstr modmsg 0 intr0)
    // set functions
    (2 modmsg set_intmsg set_intmsgstr intr0)
    (2 modmsg set_doublemsg set_doublemsgstr intr0)
    (2 modmsg set_stringmsg set_stringmsgstr intr0)
    (2 modmsg searchidmsg searchidmsgstr intr0)
    (2 modmsg get_intmsg get_intmsgstr intr0)
    (2 modmsg get_doublemsg get_doublemsgstr intr0)
    (2 modmsg get_stringmsg get_stringmsgstr intr0)
    (2 modmsg delete_msg delete_msgstr intr0)
    (2 modmsg init_msg init_msgstr intr0)
    (2 modmsg free_msg free_msgstr intr0)
    (2 modmsg get_type_msg get_type_msgstr intr0)

    (maxmsg stpushi)
    (3 modmsg init_msg 0 intr0)
    // return value back to caller
(funcend)

(msg_set_int func)
     (3 modmsg set_intmsg 0 intr0)
(funcend)
(msg_set_double func)
     (3 modmsg set_doublemsg 0 intr0)
(funcend)
(msg_set_string func)
     (3 modmsg set_stringmsg 0 intr0)
(funcend)
(msg_get_int func)
     (3 modmsg get_intmsg 0 intr0)
(funcend)
(msg_get_double func)
     (3 modmsg get_doublemsg 0 intr0)
(funcend)
(msg_get_string func)
     (3 modmsg get_stringmsg 0 intr0)
(funcend)
(msg_search_id func)
     (3 modmsg searchidmsg 0 intr0)
(funcend)
(msg_delete func)
    (3 modmsg delete_msg 0 intr0)
(funcend)
(msg_free func)
     (3 modmsg free_msg 0 intr0)
(funcend)
(msg_get_type func)
    (3 modmsg get_type_msg 0 intr0)
(funcend)
