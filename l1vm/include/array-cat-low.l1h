		(byte_idx~ < arraya_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ byte_idx~ ] var~ :=)
			(var~ :pull_int32_var !)
			(var~ == match~ f~ :=)
			(f~ if)
				(one~ found_var~ :=)
				(:check_a_array_end_int32_member jmp)
			(endif)
			(byte_idx~ + offset~ byte_idx~ :=)
			(:check_a_array_int32_member jmp)
		(endif)

	(:check_a_array_end_int32_member)
	(found_var~ == one~ f~ :=)
	(f~ if+)
		(Parraya~ Parraya~ Parrayc~ zero~ last_idx~ neg_one~ zero~ :array_int32_cat_range !)
		(zero~ stpush)
	(else)
		(one~ stpush)
	(endif)
(funcend)
