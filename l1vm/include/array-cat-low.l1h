			(var~ == match~ f~ :=)
			(f~ if)
				(one~ found_var~ :=)
				(:check_a_array_end_int16_member jmp)
			(endif)
			(byte_idx~ + offset~ byte_idx~ :=)
			(:check_a_array_int16_member jmp)
		(endif)

	(:check_a_array_end_int16_member)
	(found_var~ == one~ f~ :=)
