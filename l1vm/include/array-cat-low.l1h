	(arrayb_bytes~ :pull_int64_var !)
	(arrayb_bytes~ / offset~ last_b_idx~ :=)
	(last_b_idx~ - one~ last_b_idx~ :=)

	(Parraya~ Parrayb~ Parrayc~ zero~ zero~ zero~ last_b_idx~ :array_int32_cat_range !)
(funcend)

// member: check if match is in Parraya~; if found, copy Parraya~ to Parrayc~ and push 0, else push 1
(array_byte_member func)
	#var ~ array_byte_member

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 1)

	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arraya_bytes~ 0)
	(set int64 1 last_idx~ 0)
	(set int64 1 byte_idx~ 0)
	(set int64 1 f~ 0)
	(set byte 1 var~ 0)
	(set int64 1 found_var~ 0)
	(set byte 1 match~ 0)

	(Parrayc~ stpop)
	(match~ stpop)
	(Parraya~ stpop)

	(zero~ byte_idx~ :=)
	(zero~ found_var~ :=)

	(Parraya~ arraya_bytes~ :get_size !)
	(arraya_bytes~ :pull_int64_var !)
	(arraya_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(:check_a_array_byte_member)
		(byte_idx~ < arraya_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ byte_idx~ ] var~ :=)
			(var~ :pull_byte_var !)
			(var~ == match~ f~ :=)
			(f~ if)
				(one~ found_var~ :=)
				(:check_a_array_end_byte_member jmp)
			(endif)
			(byte_idx~ + offset~ byte_idx~ :=)
			(:check_a_array_byte_member jmp)
		(endif)

	(:check_a_array_end_byte_member)
	(found_var~ == one~ f~ :=)
	(f~ if+)
		(Parraya~ Parraya~ Parrayc~ zero~ last_idx~ neg_one~ zero~ :array_byte_cat_range !)
		(zero~ stpush)
	(else)
		(one~ stpush)
	(endif)
(funcend)

(array_int16_member func)
	#var ~ array_int16_member

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 2)

