// array-cat-low.l1h
// byte, int16, int32 variable types
// cat two arrays a and b to array c
// get first array element
// get rest of array: index 1 - end of array
// cons element/array onto array
// member: check if value is in array

// byte
(array_byte_cat func)
	#var ~ array_byte_cat

	(set const-int64 1 zero~ 0)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)

	(set int64 1 arraya_size~ 0)
	(set int64 1 arrayb_size~ 0)
	(set int64 1 index~ 0)
	(set int64 1 cindex~ 0)
	(set const-int64 1 offset~ 1)
	(set int64 1 f~ 0)
	(set byte 1 var~ 0)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(zero~ index~ :=)
	(zero~ cindex~ :=)

	// copy array a to c
	(Parraya~ arraya_size~ :get_size !)
	(arraya_size~ :pull_int64_var !)

	(:copy_a_array_byte_cat)
		(index~ < arraya_size~ f~ :=)
		(f~ if+)
			(Parraya~ [ index~ ] var~ :=)
			(var~ :pull_byte_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(:copy_a_array_byte_cat jmp)
		(endif)

	// copy array b to c
	(zero~ index~ :=)
	(Parrayb~ arrayb_size~ :get_size !)
	(arrayb_size~ :pull_int64_var !)

	(:copy_b_array_byte_cat)
		(index~ < arrayb_size~ f~ :=)
		(f~ if+)
			(Parrayb~ [ index~ ] var~ :=)
			(var~ :pull_byte_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(:copy_b_array_byte_cat jmp)
		(endif)
(funcend)

(array_byte_cat_range func)
	#var ~ array_byte_cat_range

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)

	(set int64 1 index~ 0)
	(set int64 1 cindex~ 0)
	(set int64 1 ind_count~ 0)
	(set const-int64 1 offset~ 1)
	(set int64 1 f~ 0)
	(set byte 1 var~ 0)

	(set int64 1 arraya_min~ 0)
	(set int64 1 arraya_max~ 0)
	(set int64 1 arrayb_min~ 0)
	(set int64 1 arrayb_max~ 0)

	(arrayb_max~ stpop)
	(arrayb_min~ stpop)
	(arraya_max~ stpop)
	(arraya_min~ stpop)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(zero~ cindex~ :=)

	// copy array a range [arraya_min..arraya_max] to c
	(arraya_min~ ind_count~ :=)
	(ind_count~ * offset~ index~ :=)

	(:copy_a_array_byte_cat_range)
		(ind_count~ <= arraya_max~ f~ :=)
		(f~ if+)
			(Parraya~ [ index~ ] var~ :=)
			(var~ :pull_byte_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(ind_count~ + one~ ind_count~ :=)
			(:copy_a_array_byte_cat_range jmp)
		(endif)

	(arrayb_min~ < zero~ f~ :=)
	(f~ if)
		(return)
	(endif)

	// copy array b range [arrayb_min..arrayb_max] to c
	(arrayb_min~ ind_count~ :=)
	(ind_count~ * offset~ index~ :=)

	(:copy_b_array_byte_cat_range)
		(ind_count~ <= arrayb_max~ f~ :=)
		(f~ if+)
			(Parrayb~ [ index~ ] var~ :=)
			(var~ :pull_byte_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(ind_count~ + one~ ind_count~ :=)
			(:copy_b_array_byte_cat_range jmp)
		(endif)
(funcend)

// return first element
(array_byte_first func)
	#var ~ array_byte_first

	(set const-int64 1 zero~ 0)
	(set int64 1 Parray~ 0)
	(set byte 1 var~ 0)

	(Parray~ stpop)
	(Parray~ [ zero~ ] var~ :=)
	(var~ :pull_byte_var !)

	(var~ stpush)
(funcend)

// return rest = index 1 - last element index
(array_byte_rest func)
	#var ~ array_byte_rest

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 1)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 array_bytes~ 0)
	(set int64 1 last_idx~ 0)

	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parraya~ array_bytes~ :get_size !)
	(array_bytes~ :pull_int64_var !)
	(array_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(Parraya~ Parraya~ Parrayb~ one~ last_idx~ neg_one~ zero~ :array_byte_cat_range !)
(funcend)

