// cons array
// put element 0 of Parraya~ and full array of Parrayb~ to Parrayc~
(array_byte_cons func)
	#var ~ array_byte_cons

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 offset~ 1)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arrayb_bytes~ 0)
	(set int64 1 last_b_idx~ 0)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parrayb~ arrayb_bytes~ :get_size !)
	(arrayb_bytes~ :pull_int64_var !)
	(arrayb_bytes~ / offset~ last_b_idx~ :=)
	(last_b_idx~ - one~ last_b_idx~ :=)

	(Parraya~ Parrayb~ Parrayc~ zero~ zero~ zero~ last_b_idx~ :array_byte_cat_range !)
(funcend)

