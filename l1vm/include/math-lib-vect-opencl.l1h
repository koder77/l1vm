// math vect library
//
//
(oclmath_vect_init func)
    (set string s modulestr@mathvectocl "libl1vmmathvect-opencl")
	// int array
	(set string s mvect_add_intstr@mathvectocl "mvect_add_int")
	(set string s mvect_sub_intstr@mathvectocl "mvect_sub_int")
	(set string s mvect_mul_intstr@mathvectocl "mvect_mul_int")
	(set string s mvect_div_intstr@mathvectocl "mvect_div_int")
	(set string s mvect_add_int_arraystr@mathvectocl "mvect_add_int_array")
	(set string s mvect_sub_int_arraystr@mathvectocl "mvect_sub_int_array")
	(set string s mvect_mul_int_arraystr@mathvectocl "mvect_mul_int_array")
	(set string s mvect_div_int_arraystr@mathvectocl "mvect_div_int_array")
	// double array
	(set string s mvect_add_doublestr@mathvectocl "mvect_add_double")
	(set string s mvect_sub_doublestr@mathvectocl "mvect_sub_double")
	(set string s mvect_mul_doublestr@mathvectocl "mvect_mul_double")
	(set string s mvect_div_doublestr@mathvectocl "mvect_div_double")
	(set string s mvect_add_double_arraystr@mathvectocl "mvect_add_double_array")
	(set string s mvect_sub_double_arraystr@mathvectocl "mvect_sub_double_array")
	(set string s mvect_mul_double_arraystr@mathvectocl "mvect_mul_double_array")
	(set string s mvect_div_double_arraystr@mathvectocl "mvect_div_double_array")
    // min/max number functions
	(set string s mvect_min_intstr@mathvectocl "mvect_min_int")
    (set string s mvect_max_intstr@mathvectocl "mvect_max_int")
	(set string s mvect_min_doublestr@mathvectocl "mvect_min_double")
    (set string s mvect_max_doublestr@mathvectocl "mvect_max_double")
	// sort functions
	(set string s mvect_sort_int_incstr@mathvectocl "mvect_sort_int_inc")
	(set string s mvect_sort_int_decstr@mathvectocl "mvect_sort_int_dec")
	(set string s mvect_sort_double_incstr@mathvectocl "mvect_sort_double_inc")
	(set string s mvect_sort_double_decstr@mathvectocl "mvect_sort_double_dec")
	// average functions
	(set string s mvect_average_intstr@mathvectocl "mvect_average_int")
	(set string s mvect_average_doublestr@mathvectocl "mvect_average_double")
	// array copy function
	(set string s mvect_array_copystr@mathvectocl "mvect_array_copy")
	// array clear
	(set string s mvect_array_clearstr@mathvectocl "mvect_array_clear")
	// search
	(set string s mvect_array_search_intstr@mathvectocl "mvect_array_search_int")
	(set string s mvect_array_search_doublestr@mathvectocl "mvect_array_search_double")
	// array init
	(set string s mvect_array_init_bytestr@mathvectocl "mvect_array_init_byte")
	(set string s mvect_array_init_int64str@mathvectocl "mvect_array_init_int64")
    (set string s mvect_shutdownstr@mathvectocl "mvect_opencl_shutdown")
	// slot operations
	(set string s mvect_pushstr@mathvectocl "oclmath_push")
	(set string s mvect_pullstr@mathvectocl "oclmath_pull")
	// number defs int
	(set int64 1 mvect_add_int@mathvectocl 0)
	(set int64 1 mvect_sub_int@mathvectocl 1)
	(set int64 1 mvect_mul_int@mathvectocl 2)
	(set int64 1 mvect_div_int@mathvectocl 3)
	(set int64 1 mvect_add_int_array@mathvectocl 4)
	(set int64 1 mvect_sub_int_array@mathvectocl 5)
	(set int64 1 mvect_mul_int_array@mathvectocl 6)
	(set int64 1 mvect_div_int_array@mathvectocl 7)
	// number defs double
	(set int64 1 mvect_add_double@mathvectocl 8)
	(set int64 1 mvect_sub_double@mathvectocl 9)
	(set int64 1 mvect_mul_double@mathvectocl 10)
	(set int64 1 mvect_div_double@mathvectocl 11)
	(set int64 1 mvect_add_double_array@mathvectocl 12)
	(set int64 1 mvect_sub_double_array@mathvectocl 13)
	(set int64 1 mvect_mul_double_array@mathvectocl 14)
	(set int64 1 mvect_div_double_array@mathvectocl 15)
	// min/max number functions
	(set int64 1 mvect_min_int@mathvectocl 16)
	(set int64 1 mvect_max_int@mathvectocl 17)
	(set int64 1 mvect_min_double@mathvectocl 18)
	(set int64 1 mvect_max_double@mathvectocl 19)
	// sort number functions
	(set int64 1 mvect_sort_int_inc@mathvectocl 20)
	(set int64 1 mvect_sort_int_dec@mathvectocl 21)
	(set int64 1 mvect_sort_double_inc@mathvectocl 22)
	(set int64 1 mvect_sort_double_dec@mathvectocl 23)
	// average functions
	(set int64 1 mvect_average_int@mathvectocl 24)
	(set int64 1 mvect_average_double@mathvectocl 25)
	// array copy
	(set int64 1 mvect_array_copy@mathvectocl 26)
	// array clear
	(set int64 1 mvect_array_clear@mathvectocl 27)
	// search
	(set int64 1 mvect_array_search_int@mathvectocl 28)
	(set int64 1 mvect_array_search_double@mathvectocl 29)
	// init
	(set int64 1 mvect_array_init_byte@mathvectocl 30)
	(set int64 1 mvect_array_init_int64@mathvectocl 31)
    (set int64 1 mvect_shutdown@mathvectocl 32)
    (set int64 1 mvect_push@mathvectocl 33)
    (set int64 1 mvect_pull@mathvectocl 34)
    (set int64 1 mod@mathvectocl 0)
    // get argument from stack
    (mod@mathvectocl stpopi)
    // load math module
    (0 modulestr@mathvectocladdr mod@mathvectocl 0 intr0)
    // set functions int
	(2 mod@mathvectocl mvect_add_int@mathvectocl mvect_add_intstr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_sub_int@mathvectocl mvect_sub_intstr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_mul_int@mathvectocl mvect_mul_intstr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_div_int@mathvectocl mvect_div_intstr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_add_int_array@mathvectocl mvect_add_int_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_sub_int_array@mathvectocl mvect_sub_int_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_mul_int_array@mathvectocl mvect_mul_int_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_div_int_array@mathvectocl mvect_div_int_arraystr@mathvectocladdr intr0)
	// set functions double
	(2 mod@mathvectocl mvect_add_double@mathvectocl mvect_add_doublestr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_sub_double@mathvectocl mvect_sub_doublestr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_mul_double@mathvectocl mvect_mul_doublestr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_div_double@mathvectocl mvect_div_doublestr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_add_double_array@mathvectocl mvect_add_double_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_sub_double_array@mathvectocl mvect_sub_double_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_mul_double_array@mathvectocl mvect_mul_double_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_div_double_array@mathvectocl mvect_div_double_arraystr@mathvectocladdr intr0)
	(2 mod@mathvectocl mvect_min_int@mathvectocl mvect_min_intstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_max_int@mathvectocl mvect_max_intstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_min_double@mathvectocl mvect_min_doublestr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_max_double@mathvectocl mvect_max_doublestr@mathvectocl intr0)
	// sort
	(2 mod@mathvectocl mvect_sort_int_inc@mathvectocl mvect_sort_int_incstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_sort_int_dec@mathvectocl mvect_sort_int_decstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_sort_double_inc@mathvectocl mvect_sort_double_incstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_sort_double_dec@mathvectocl mvect_sort_double_decstr@mathvectocl intr0)
	// average
	(2 mod@mathvectocl mvect_average_int@mathvectocl mvect_average_intstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_average_double@mathvectocl mvect_average_doublestr@mathvectocl intr0)
	// array copy
	(2 mod@mathvectocl mvect_array_copy@mathvectocl mvect_array_copystr@mathvectocl intr0)
	// array clear
	(2 mod@mathvectocl mvect_array_clear@mathvectocl mvect_array_clearstr@mathvectocl intr0)
	// search
	(2 mod@mathvectocl mvect_array_search_int@mathvectocl mvect_array_search_intstr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_array_search_double@mathvectocl mvect_array_search_doublestr@mathvectocl intr0)
	// init
	(2 mod@mathvectocl mvect_array_init_byte@mathvectocl mvect_array_init_bytestr@mathvectocl intr0)
	(2 mod@mathvectocl mvect_array_init_int64@mathvectocl mvect_array_init_int64str@mathvectocl intr0)
    (2 mod@mathvectocl mvect_shutdown@mathvectocl mvect_shutdownstr@mathvectocl intr0)
    // set functions slots
    (2 mod@mathvectocl mvect_push@mathvectocl mvect_pushstr@mathvectocl intr0)
    (2 mod@mathvectocl mvect_pull@mathvectocl mvect_pullstr@mathvectocl intr0)
	(funcend)
// wrapper functions
(oclvmath_add_int func)
	(3 mod@mathvectocl mvect_add_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_sub_int func)
	(3 mod@mathvectocl mvect_sub_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_mul_int func)
	(3 mod@mathvectocl mvect_mul_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_div_int func)
	(3 mod@mathvectocl mvect_div_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_add_int_array func)
	(3 mod@mathvectocl mvect_add_int_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_sub_int_array func)
	(3 mod@mathvectocl mvect_sub_int_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_mul_int_array func)
	(3 mod@mathvectocl mvect_mul_int_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_div_int_array func)
	(3 mod@mathvectocl mvect_div_int_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_add_double func)
	(3 mod@mathvectocl mvect_add_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_sub_double func)
	(3 mod@mathvectocl mvect_sub_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_mul_double func)
	(3 mod@mathvectocl mvect_mul_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_div_double func)
	(3 mod@mathvectocl mvect_div_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_add_double_array func)
	(3 mod@mathvectocl mvect_add_double_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_sub_double_array func)
	(3 mod@mathvectocl mvect_sub_double_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_mul_double_array func)
	(3 mod@mathvectocl mvect_mul_double_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_div_double_array func)
	(3 mod@mathvectocl mvect_div_double_array@mathvectocl 0 intr0)
(funcend)
(oclvmath_min_int func)
	(3 mod@mathvectocl mvect_min_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_max_int func)
	(3 mod@mathvectocl mvect_max_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_min_double func)
	(3 mod@mathvectocl mvect_min_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_max_double func)
	(3 mod@mathvectocl mvect_max_double@mathvectocl 0 intr0)
(funcend)
// sort
(oclvmath_sort_int_inc func)
	(3 mod@mathvectocl mvect_sort_int_inc@mathvectocl 0 intr0)
(funcend)
(oclvmath_sort_int_dec func)
	(3 mod@mathvectocl mvect_sort_int_dec@mathvectocl 0 intr0)
(funcend)
(oclvmath_average_int func)
	(3 mod@mathvectocl mvect_average_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_average_double func)
	(3 mod@mathvectocl mvect_average_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_copy func)
	(3 mod@mathvectocl mvect_array_copy@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_clear func)
    (3 mod@mathvectocl mvect_array_clear@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_search_int func)
    (3 mod@mathvectocl mvect_array_search_int@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_search_double func)
    (3 mod@mathvectocl mvect_array_search_double@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_init_byte func)
	 (3 mod@mathvectocl mvect_array_init_byte@mathvectocl 0 intr0)
(funcend)
(oclvmath_array_init_int64 func)
	 (3 mod@mathvectocl mvect_array_init_int64@mathvectocl 0 intr0)
(funcend)
(oclvmath_shutdown func)
    (3 mod@mathvectocl mvect_shutdown@mathvectocl 0 intr0)
(funcend)
(oclmath_push func)
    (3 mod@mathvectocl mvect_push@mathvectocl 0 intr0)
(funcend)
(oclmath_pull func)
    (3 mod@mathvectocl mvect_pull@mathvectocl 0 intr0)
(funcend)
