// array-cat.l1h
// cat two arrays a and b to array c
// get first array element
// get rest of array: index 1 - end of array
// cons element onto array
// member: check if value is in array

(array_int64_cat func)
	#var ~ array_int64_cat

	(set const-int64 1 zero~ 0)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 var~ 0)
	(set int64 1 arraya_size~ 0)
	(set int64 1 arrayb_size~ 0)
	(set int64 1 index~ 0)
	(set int64 1 cindex~ 0)
	(set const-int64 1 offset~ 8)
	(set int64 1 f~ 0)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(zero~ index~ :=)
	(zero~ cindex~ :=)

	// copy array a to c
	(Parraya~ arraya_size~ :get_size !)
	(arraya_size~ :pull_int64_var !)

	(:copy_a_array_int64_cat)
		(index~ < arraya_size~ f~ :=)
		(f~ if+)
			(Parraya~ [ index~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(:copy_a_array_int64_cat jmp)
		(endif)

	// copy array b to c
	(zero~ index~ :=)
	(Parrayb~ arrayb_size~ :get_size !)
	(arrayb_size~ :pull_int64_var !)

	(:copy_b_array_int64_cat)
		(index~ < arrayb_size~ f~ :=)
		(f~ if+)
			(Parrayb~ [ index~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(:copy_b_array_int64_cat jmp)
		(endif)
(funcend)

(array_int64_cat_range func)
	#var ~ array_int64_cat_range

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)

	(set int64 1 index~ 0)
	(set int64 1 cindex~ 0)
	(set int64 1 ind_count~ 0)
	(set const-int64 1 offset~ 8)
	(set int64 1 f~ 0)
	(set int64 1 var~ 0)

	(set int64 1 arraya_min~ 0)
	(set int64 1 arraya_max~ 0)
	(set int64 1 arrayb_min~ 0)
	(set int64 1 arrayb_max~ 0)

	(arrayb_max~ stpop)
	(arrayb_min~ stpop)
	(arraya_max~ stpop)
	(arraya_min~ stpop)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(zero~ cindex~ :=)

	// copy array a range [arraya_min..arraya_max] to c
	(arraya_min~ ind_count~ :=)
	(ind_count~ * offset~ index~ :=)

	(:copy_a_array_int64_cat_range)
		(ind_count~ <= arraya_max~ f~ :=)
		(f~ if+)
			(Parraya~ [ index~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(ind_count~ + one~ ind_count~ :=)
			(:copy_a_array_int64_cat_range jmp)
		(endif)

	(arrayb_min~ < zero~ f~ :=)
	(f~ if)
		(return)
	(endif)

	// copy array b range [arrayb_min..arrayb_max] to c
	(arrayb_min~ ind_count~ :=)
	(ind_count~ * offset~ index~ :=)

	(:copy_b_array_int64_cat_range)
		(ind_count~ <= arrayb_max~ f~ :=)
		(f~ if+)
			(Parrayb~ [ index~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ Parrayc~ [ cindex~ ] :=)
			(index~ + offset~ index~ :=)
			(cindex~ + offset~ cindex~ :=)
			(ind_count~ + one~ ind_count~ :=)
			(:copy_b_array_int64_cat_range jmp)
		(endif)
(funcend)

