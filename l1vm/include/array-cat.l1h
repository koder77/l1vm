// return first element
(array_int64_first func)
	#var ~ array_int64_first

	(set const-int64 1 zero~ 0)
	(set int64 1 Parray~ 0)
	(set int64 1 var~ 0)

	(Parray~ stpop)
	(Parray~ [ zero~ ] var~ :=)
	(var~ :pull_int64_var !)

	(var~ stpush)
(funcend)

(array_double_first func)
	#var ~ array_double_first

	(set const-int64 1 zero~ 0)
	(set int64 1 Parray~ 0)
	(set double 1 var~ 0.0)

	(Parray~ stpop)
	(Parray~ [ zero~ ] var~ :=)
	(var~ :pull_double_var !)

	(var~ stpush)
(funcend)

// return rest = index 1 .. last element index
(array_int64_rest func)
	#var ~ array_int64_rest

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 array_bytes~ 0)
	(set int64 1 last_idx~ 0)

	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parraya~ array_bytes~ :get_size !)
	(array_bytes~ :pull_int64_var !)
	(array_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(Parraya~ Parraya~ Parrayb~ one~ last_idx~ neg_one~ zero~ :array_int64_cat_range !)
(funcend)

(array_double_rest func)
	#var ~ array_double_rest

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 array_bytes~ 0)
	(set int64 1 last_idx~ 0)

	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parraya~ array_bytes~ :get_size !)
	(array_bytes~ :pull_int64_var !)
	(array_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(Parraya~ Parraya~ Parrayb~ one~ last_idx~ neg_one~ zero~ :array_double_cat_range !)
(funcend)

(array_int64_cons func)
	#var ~ array_int64_cons

	(set const-int64 1 zero~ 0)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arrayb_bytes~ 0)
	(set int64 1 last_b_idx~ 0)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parrayb~ arrayb_bytes~ :get_size !)
	(arrayb_bytes~ :pull_int64_var !)
	(arrayb_bytes~ / offset~ last_b_idx~ :=)
	(last_b_idx~ - neg_one~ last_b_idx~ :=)

	(Parraya~ Parrayb~ Parrayc~ zero~ zero~ zero~ last_b_idx~ :array_int64_cat_range !)
(funcend)

(array_double_cons func)
	#var ~ array_double_cons

	(set const-int64 1 zero~ 0)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayb~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arrayb_bytes~ 0)
	(set int64 1 last_b_idx~ 0)

	(Parrayc~ stpop)
	(Parrayb~ stpop)
	(Parraya~ stpop)

	(Parrayb~ arrayb_bytes~ :get_size !)
	(arrayb_bytes~ :pull_int64_var !)
	(arrayb_bytes~ / offset~ last_b_idx~ :=)
	(last_b_idx~ - neg_one~ last_b_idx~ :=)

	(Parraya~ Parrayb~ Parrayc~ zero~ zero~ zero~ last_b_idx~ :array_double_cat_range !)
(funcend)

// member: check if match is in Parraya~; if found, copy Parraya~ to Parrayc~ and push 0 (true), else push 1 (false)
(array_int64_member func)
	#var ~ array_int64_member

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)

	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arraya_bytes~ 0)
	(set int64 1 last_idx~ 0)
	(set int64 1 byte_idx~ 0)
	(set int64 1 f~ 0)
	(set int64 1 var~ 0)
	(set int64 1 found~ 0)
	(set int64 1 match~ 0)

	(Parrayc~ stpop)
	(match~ stpop)
	(Parraya~ stpop)

	(zero~ byte_idx~ :=)
	(zero~ found~ :=)

	(Parraya~ arraya_bytes~ :get_size !)
	(arraya_bytes~ :pull_int64_var !)
	(arraya_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(:check_a_array_int64_member)
		(byte_idx~ < arraya_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ byte_idx~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ == match~ f~ :=)
			(f~ if)
				(one~ found~ :=)
				(:check_a_array_end_int64_member jmp)
			(endif)
			(byte_idx~ + offset~ byte_idx~ :=)
			(:check_a_array_int64_member jmp)
		(endif)

	(:check_a_array_end_int64_member)
	(found~ == one~ f~ :=)
	(f~ if+)
		(Parraya~ Parraya~ Parrayc~ zero~ last_idx~ neg_one~ zero~ :array_int64_cat_range !)
		(zero~ stpush)
	(else)
		(one~ stpush)
	(endif)
(funcend)

(array_double_member func)
	#var ~ array_double_member

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 neg_one~ -1)
	(set const-int64 1 offset~ 8)

	(set int64 1 Parraya~ 0)
	(set int64 1 Parrayc~ 0)
	(set int64 1 arraya_bytes~ 0)
	(set int64 1 last_idx~ 0)
	(set int64 1 byte_idx~ 0)
	(set int64 1 f~ 0)
	(set double 1 var~ 0.0)
	(set int64 1 found~ 0)
	(set double 1 match~ 0.0)

	(Parrayc~ stpop)
	(match~ stpop)
	(Parraya~ stpop)

	(zero~ byte_idx~ :=)
	(zero~ found~ :=)

	(Parraya~ arraya_bytes~ :get_size !)
	(arraya_bytes~ :pull_int64_var !)
	(arraya_bytes~ / offset~ last_idx~ :=)
	(last_idx~ - one~ last_idx~ :=)

	(:check_a_array_double_member)
		(byte_idx~ < arraya_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ byte_idx~ ] var~ :=)
			(var~ :pull_double_var !)
			(var~ ==d match~ f~ :=)
			(f~ if)
				(one~ found~ :=)
				(:check_a_array_end_double_member jmp)
			(endif)
			(byte_idx~ + offset~ byte_idx~ :=)
			(:check_a_array_double_member jmp)
		(endif)

	(:check_a_array_end_double_member)
	(found~ == one~ f~ :=)
	(f~ if+)
		(Parraya~ Parraya~ Parrayc~ zero~ last_idx~ neg_one~ zero~ :array_double_cat_range !)
		(zero~ stpush)
	(else)
		(one~ stpush)
	(endif)
(funcend)
