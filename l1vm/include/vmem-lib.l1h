// vmem library
//
//
(mem_init func)
	// normal array functions
	(set string s modulestr@vmem "libl1vmvmem")
	(set string s initstr@vmem "init_mem")
	(set string s allocbytestr@vmem "alloc_byte")
	(set string s allocint64str@vmem "alloc_int64")
	(set string s allocdoublestr@vmem "alloc_double")
	(set string s deallocstr@vmem "dealloc_mem")
	(set string s int_to_arraystr@vmem "int_to_array")
	(set string s array_to_instr@mod "array_to_int")
	(set string s double_to_arraystr@vmem "double_to_array")
	(set string s array_to_doublestr@vmem "array_to_double")
	(set string s free@vmemstr "free_mem")
	(set int64 1 init@vmem 0)
	(set int64 1 allocbyte@vmem 1)
	(set int64 1 allocint64@vmem 4)
	(set int64 1 allocdouble@vmem 5)
	(set int64 1 dealloc@vmem 6)
	(set int64 1 int_to_array@vmem 7)
	(set int64 1 array_to_int@vmem 8)
	(set int64 1 double_to_array@vmem 9)
	(set int64 1 array_to_double@vmem 10)
	(set int64 1 free@vmem 11)
	(set int64 1 mod@vmem 0)
	(set int64 1 maxind@vmem 0)
	// get arguments from stack
	(maxind@vmem stpopi)
	(mod@vmem stpopi)
	// load mem module
	(0 modulestr@vmemaddr mod@vmem 0 intr0)
	// set functions
	(2 mod@vmem init@vmem initstr@vmemaddr intr0)
	(2 mod@vmem allocbyte@vmem allocbytestr@vmemaddr intr0)
	(2 mod@vmem allocint64@vmem allocint64str@vmemaddr intr0)
	// (2 mod@vmem allocdouble@vmem allocdoublestr@vmemaddr intr0)
	(2 mod@vmem dealloc@vmem deallocstr@vmemaddr intr0)
	(2 mod@vmem int_to_array@vmem int_to_arraystr@vmemaddr intr0)
	(2 mod@vmem array_to_int@vmem array_to_instr@modaddr intr0)
	// (2 mod@vmem double_to_array@vmem double_to_arraystr@vmemaddr intr0)
	// (2 mod@vmem array_to_double@vmem array_to_doublestr@vmemaddr intr0)
	(2 mod@vmem free@vmem free@vmemstraddr intr0)
	// init module
	(maxind@vmem stpushi)
	(3 mod@vmem init@vmem 0 intr0)
	// return value back to caller
(funcend)
// wrapper functions
(alloc_byte func)
	(3 mod@vmem allocbyte@vmem 0 intr0)
(funcend)
(alloc_int64 func)
	(3 mod@vmem allocint64@vmem 0 intr0)
(funcend)
(alloc_double func)
	(3 mod@vmem allocdouble@vmem 0 intr0)
(funcend)
(dealloc func)
	(3 mod@vmem dealloc@vmem 0 intr0)
(funcend)
(int_to_array func)
	(3 mod@vmem int_to_array@vmem 0 intr0)
(funcend)
(array_to_int func)
	(3 mod@vmem array_to_int@vmem 0 intr0)
(funcend)
(double_to_array func)
	(3 mod@vmem double_to_array@vmem 0 intr0)
(funcend)
(array_to_double func)
	(3 mod@vmem array_to_double@vmem 0 intr0)
(funcend)
(free_mem func)
	(3 mod@vmem free@vmem 0 intr0)
(funcend)
