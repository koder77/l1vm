// endianess library
//
//
(endianess_init func)
    (set const-string s modulestr@end "libl1vmendianess")
    (set const-string s host_to_nwstr@end "host_to_nw")
    (set const-string s n_to_hostwstr@end "n_to_hostw")
    (set const-string s host_to_ndwstr@end "host_to_ndw")
    (set const-string s n_to_hostdwstr@end "n_to_hostdw")
    (set const-string s host_to_nqwstr@end "host_to_nqw")
    (set const-string s n_to_hostqwstr@end "n_to_hostqw")

    (set const-string s bytes_to_int16str@end "bytes_to_int16")
    (set const-string s bytes_to_int32str@end "bytes_to_int32")
    (set const-string s bytes_to_int64str@end "bytes_to_int64")
    (set const-string s bytes_to_doublestr@end "bytes_to_double")

    (set const-int64 1 host_to_nw@end 0)
    (set const-int64 1 n_to_hostw@end 1)
    (set const-int64 1 host_to_ndw@end 2)
    (set const-int64 1 n_to_hostdw@end 3)
    (set const-int64 1 host_to_nqw@end 4)
    (set const-int64 1 n_to_hostqw@end 5)

    (set const-int64 1 bytes_to_int16@end 6)
    (set const-int64 1 bytes_to_int32@end 7)
    (set const-int64 1 bytes_to_int64@end 8)
    (set const-int64 1 bytes_to_double@end 9)

    (set int64 1 mod@end 0)
    // get arguments from stack
    (mod@end stpopi)
    // load endianess module
    (0 modulestr@endaddr mod@end 0 intr0)
    // set functions
    (2 mod@end host_to_nw@end host_to_nwstr@endaddr intr0)
    (2 mod@end n_to_hostw@end n_to_hostwstr@endaddr intr0)
    (2 mod@end host_to_ndw@end host_to_ndwstr@endaddr intr0)
    (2 mod@end n_to_hostdw@end n_to_hostdwstr@endaddr intr0)
    (2 mod@end host_to_nqw@end host_to_nqwstr@endaddr intr0)
    (2 mod@end n_to_hostqw@end n_to_hostqwstr@endaddr intr0)

    (2 mod@end bytes_to_int16@end bytes_to_int16str@end intr0)
    (2 mod@end bytes_to_int32@end bytes_to_int32str@end intr0)
    (2 mod@end bytes_to_int64@end bytes_to_int64str@end intr0)
    (2 mod@end bytes_to_double@end bytes_to_doublestr@end intr0)
(funcend)
// wrapper functions
(end_host_to_nw func)
    (3 mod@end host_to_nw@end 0 intr0)
(funcend)
(end_n_to_hostw func)
    (3 mod@end n_to_hostw@end 0 intr0)
(funcend)
(end_host_to_ndw func)
    (3 mod@end host_to_ndw@end 0 intr0)
(funcend)
(end_n_to_hostdw func)
    (3 mod@end n_to_hostdw@end 0 intr0)
(funcend)
(end_host_to_nqw func)
    (3 mod@end host_to_nqw@end 0 intr0)
(funcend)
(end_n_to_hostqw func)
    (3 mod@end n_to_hostqw@end 0 intr0)
(funcend)

// single bytes to number variables
(end_bytes_to_int16 func)
   (3 mod@end bytes_to_int16@end 0 intr0)
(funcend)
(end_bytes_to_int32 func)
   (3 mod@end bytes_to_int32@end 0 intr0)
(funcend)
(end_bytes_to_int64 func)
   (3 mod@end bytes_to_int64@end 0 intr0)
(funcend)
(end_bytes_to_double func)
   (3 mod@end bytes_to_double@end 0 intr0)
(funcend)
