		(dst_byte~ - offset~ dst_byte~ :=)
		(:copy_array_int16_push jmp)

	(:copy_array_int16_push_end)
	(new_var~ Parraya~ [ zero~ ] :=)
(funcend)

(array_int16_pop func)
