// array-misc.l1h
// push element to front (shift elements right) and pop front element (shift elements left)
// for int64 and double arrays

(array_int64_push func)
	#var ~ array_int64_push

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 new_var~ 0)
	(set int64 1 active_count~ 0)
	(set int64 1 capacity_bytes~ 0)
	(set int64 1 max_last_idx~ 0)
	(set int64 1 src_byte~ 0)
	(set int64 1 dst_byte~ 0)
	(set int64 1 var~ 0)
	(set int64 1 f~ 0)

	(active_count~ stpop)
	(new_var~ stpop)
	(Parraya~ stpop)

	(Parraya~ capacity_bytes~ :get_size !)
	(capacity_bytes~ :pull_int64_var !)
	(capacity_bytes~ / offset~ max_last_idx~ :=)
	(max_last_idx~ - one~ max_last_idx~ :=)

	// Wenn active_count~ gleich 0 ist, nur an Index 0 schreiben
	(active_count~ <= zero~ f~ :=)
	(f~ if)
		(new_var~ Parraya~ [ zero~ ] :=)
		(return)
	(endif)

	// Letzten aktiven Index auf max_last_idx~ begrenzen
	(active_count~ - one~ src_byte~ :=)
	(src_byte~ > max_last_idx~ f~ :=)
	(f~ if)
		(max_last_idx~ src_byte~ :=)
	(endif)

	// Ziel-Index ist src_idx + 1; nur verschieben, falls src_idx < max_last_idx~
	(src_byte~ < max_last_idx~ f~ :=)
	(f~ if)
		(src_byte~ + one~ dst_byte~ :=)
		(src_byte~ * offset~ src_byte~ :=)
		(dst_byte~ * offset~ dst_byte~ :=)
	(else)
		(max_last_idx~ - one~ src_byte~ :=)
		(max_last_idx~ src_byte~ < f~ :=)
		(f~ if)
			(return)
		(endif)
		(src_byte~ + one~ dst_byte~ :=)
		(src_byte~ * offset~ src_byte~ :=)
		(dst_byte~ * offset~ dst_byte~ :=)
	(endif)

	(:copy_array_int64_push)
		(src_byte~ < zero~ f~ :=)
		(f~ if)
			(:copy_array_int64_push_end jmp)
		(endif)

		(Parraya~ [ src_byte~ ] var~ :=)
		(var~ :pull_int64_var !)
		(var~ Parraya~ [ dst_byte~ ] :=)

		(src_byte~ - offset~ src_byte~ :=)
		(dst_byte~ - offset~ dst_byte~ :=)
		(:copy_array_int64_push jmp)

	(:copy_array_int64_push_end)
	(new_var~ Parraya~ [ zero~ ] :=)
(funcend)

(array_int64_pop func)
	#var ~ array_int64_pop

	(set const-int64 1 zero~ 0)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 array_bytes~ 0)
	(set int64 1 var~ 0)
	(set int64 1 ret_var~ 0)
	(set int64 1 insert_index~ 0)
	(set int64 1 copy_index~ 0)
	(set int64 1 f~ 0)

	(Parraya~ stpop)

	(Parraya~ array_bytes~ :get_size !)
	(array_bytes~ :pull_int64_var !)

	(array_bytes~ <= zero~ f~ :=)
	(f~ if)
		(zero~ stpush)
		(return)
	(endif)

	(Parraya~ [ zero~ ] ret_var~ :=)
	(ret_var~ :pull_int64_var !)

	(offset~ copy_index~ :=)
	(zero~ insert_index~ :=)

	(:copy_array_int64_pop)
		(copy_index~ < array_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ copy_index~ ] var~ :=)
			(var~ :pull_int64_var !)
			(var~ Parraya~ [ insert_index~ ] :=)

			(copy_index~ + offset~ copy_index~ :=)
			(insert_index~ + offset~ insert_index~ :=)
			(:copy_array_int64_pop jmp)
		(endif)

	(zero~ Parraya~ [ insert_index~ ] :=)
	(ret_var~ stpush)
(funcend)

(array_double_push func)
	#var ~ array_double_push

	(set const-int64 1 zero~ 0)
	(set const-int64 1 one~ 1)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set double 1 new_var~ 0.0)
	(set int64 1 active_count~ 0)
	(set int64 1 capacity_bytes~ 0)
	(set int64 1 max_last_idx~ 0)
	(set int64 1 src_byte~ 0)
	(set int64 1 dst_byte~ 0)
	(set double 1 var~ 0.0)
	(set int64 1 f~ 0)

	(active_count~ stpop)
	(new_var~ stpop)
	(Parraya~ stpop)

	(Parraya~ capacity_bytes~ :get_size !)
	(capacity_bytes~ :pull_int64_var !)
	(capacity_bytes~ / offset~ max_last_idx~ :=)
	(max_last_idx~ - one~ max_last_idx~ :=)

	(active_count~ <= zero~ f~ :=)
	(f~ if)
		(new_var~ Parraya~ [ zero~ ] :=)
		(return)
	(endif)

	(active_count~ - one~ src_byte~ :=)
	(src_byte~ > max_last_idx~ f~ :=)
	(f~ if)
		(max_last_idx~ src_byte~ :=)
	(endif)

	(src_byte~ < max_last_idx~ f~ :=)
	(f~ if)
		(src_byte~ + one~ dst_byte~ :=)
		(src_byte~ * offset~ src_byte~ :=)
		(dst_byte~ * offset~ dst_byte~ :=)
	(else)
		(max_last_idx~ - one~ src_byte~ :=)
		(max_last_idx~ src_byte~ < f~ :=)
		(f~ if)
			(return)
		(endif)
		(src_byte~ + one~ dst_byte~ :=)
		(src_byte~ * offset~ src_byte~ :=)
		(dst_byte~ * offset~ dst_byte~ :=)
	(endif)

	(:copy_array_double_push)
		(src_byte~ < zero~ f~ :=)
		(f~ if)
			(:copy_array_double_push_end jmp)
		(endif)

		(Parraya~ [ src_byte~ ] var~ :=)
		(var~ :pull_double_var !)
		(var~ Parraya~ [ dst_byte~ ] :=)

		(src_byte~ - offset~ src_byte~ :=)
		(dst_byte~ - offset~ dst_byte~ :=)
		(:copy_array_double_push jmp)

	(:copy_array_double_push_end)
	(new_var~ Parraya~ [ zero~ ] :=)
(funcend)

(array_double_pop func)
	#var ~ array_double_pop

	(set const-int64 1 zero~ 0)
	(set const-double 1 zerod~ 0.0)
	(set const-int64 1 offset~ 8)
	(set int64 1 Parraya~ 0)
	(set int64 1 array_bytes~ 0)
	(set double 1 var~ 0.0)
	(set double 1 ret_var~ 0.0)
	(set int64 1 insert_index~ 0)
	(set int64 1 copy_index~ 0)
	(set int64 1 f~ 0)

	(Parraya~ stpop)

	(Parraya~ array_bytes~ :get_size !)
	(array_bytes~ :pull_int64_var !)

	(array_bytes~ <= zero~ f~ :=)
	(f~ if)
		(zerod~ stpush)
		(return)
	(endif)

	(Parraya~ [ zero~ ] ret_var~ :=)
	(ret_var~ :pull_double_var !)

	(offset~ copy_index~ :=)
	(zero~ insert_index~ :=)

	(:copy_array_double_pop)
		(copy_index~ < array_bytes~ f~ :=)
		(f~ if+)
			(Parraya~ [ copy_index~ ] var~ :=)
			(var~ :pull_double_var !)
			(var~ Parraya~ [ insert_index~ ] :=)

			(copy_index~ + offset~ copy_index~ :=)
			(insert_index~ + offset~ insert_index~ :=)
			(:copy_array_double_pop jmp)
		(endif)

	(zerod~ Parraya~ [ insert_index~ ] :=)
	(ret_var~ stpush)
(funcend)
