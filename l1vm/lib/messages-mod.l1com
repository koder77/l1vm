// messages-mod.l1com
//
// message send/receive module
#include <intr.l1h>
#include <messages-mod-func.l1h>

(main func)
	(set const-int64 1 zero 0)
	(set const-int64 1 one 1)
	(set int64 1 ret 0)
	(set int64 1 memaddr 0)
	(set int64 1 message 2021)
    (set int64 1 id 10)
	(set int64 1 message_read 0)
    (set int64 1 handle 0)
    (set int64 1 message_type 0)
    (set const-int64 1 messages_max 1)
	(set const-string s messagestr "got message: ")
	(set const-string s errsendstr "error sending message!")
	(set const-string s errstr "error searching message!")
    (set const-string s msg_typestr "message type: ")
	(set int64 1 f 0)
	(zero messages_max :msg_init !)
    //(id message :msg_set_int !)
    (id message :i-> !)
	(ret stpop)
	(((ret zero !=) f :=) f if)
	    (errsendstr :print_s !)
	    (:print_n !)
	    (one :exit !)
	(endif)
    (id :msg? !)
	(handle stpop)
	(((handle zero <) f :=) f if)
	    (errstr :print_s !)
	    (:print_n !)
	    (one :exit !)
	(endif)
    (handle :->i !)
    (ret stpop)
    (message_read stpop)
    (messagestr :print_s !)
    (message_read :print_i !)
    (:print_n !)
    (handle :msgtype? !)
    (message_type stpop)
    (msg_typestr :print_s !)
    (message_type :print_i !)
    (:print_n !)

    (:msg_free !)

    (zero :exit !)
(funcend)
#include <messages-mod.l1h>
