// vecdb.l1com
//
// vecdb database module demo.
//
// A tiny "knowledge base" of documents is created.  Each document has a
// 4 dimensional embedding (a topic vector) and some text.  The documents
// are queried in three ways: semantic (vector) search, keyword (BM25)
// search and a blend of both (hybrid search).
//
#include <intr.l1h>

(main func)
	(set int64 1 zero 0)
	(set int64 1 one 1)
	(set int64 1 mod_vecdb 0)
	(set string s dbpathstr "/tmp/vecdb_demo.db")

	// the embedding space: 4 topics
	//   [0] = storage   [1] = cars   [2] = food   [3] = space
	(set double 4 vec1 1.0 0.0 0.0 0.0)
	(set double 4 vec2 0.9 0.1 0.0 0.0)
	(set double 4 vec3 0.0 1.0 0.0 0.0)
	(set double 4 vec4 0.1 0.9 0.0 0.0)
	(set double 4 vec5 0.0 0.0 1.0 0.0)
	(set double 4 vec6 0.0 0.0 0.0 1.0)

	// query embeddings
	(set double 4 qcar 0.0 1.0 0.0 0.0)
	(set double 4 qfood 0.0 0.0 1.0 0.0)

	(set int64 1 Pvec1 0)
	(set int64 1 Pvec2 0)
	(set int64 1 Pvec3 0)
	(set int64 1 Pvec4 0)
	(set int64 1 Pvec5 0)
	(set int64 1 Pvec6 0)
	(set int64 1 Pqcar 0)
	(set int64 1 Pqfood 0)
	(set int64 1 Ppath 0)
	(set int64 1 Ptextbuf 0)
	(set int64 1 Ppayload 0)
	(set int64 1 Pplbuf 0)

	// the documents
	(set string s text1 "vector databases store embeddings and support similarity search")
	(set string s text2 "a full text index ranks documents with BM25 scoring")
	(set string s text3 "an automobile engine converts fuel into motion")
	(set string s text4 "electric cars charge their batteries at home")
	(set string s text5 "apples and bananas are a delicious fruit recipe")
	(set string s text6 "NASA launched a rocket to explore a distant galaxy")

	// query strings
	(set string s qtext1 "index")
	(set string s qtext2 "recipe")

	// an opaque payload attached to record 3: the year 2026 as int64
	(set byte 8 payload 234 7 0 0 0 0 0 0)
	(set int64 1 payloadlen 8)
	(set byte 64 plbuf)
	(set int64 1 plbuflen 64)

	(set string 256 textbuf "")
	(set int64 1 textbuflen 256)

	(set int64 1 dim 4)
	(set int64 1 metric 2)
	(set int64 1 index 0)
	(set int64 1 handle 0)
	(set int64 1 status 0)
	(set int64 1 k 3)
	(set int64 1 n 0)
	(set int64 1 i 0)
	(set int64 1 f 0)
	(set int64 1 tmp 0)
	(set int64 1 tmp2 0)
	(set int64 1 b256 256)
	(set int64 1 id1 1)
	(set int64 1 id2 2)
	(set int64 1 id3 3)
	(set int64 1 id4 4)
	(set int64 1 id5 5)
	(set int64 1 id6 6)
	(set double 1 alpha 0.5)
	(set double 1 score 0.0)

	// output labels
	(set string s s_banner "=== vecdb demo =================================================")
	(set string s s_opened "opened ")
	(set string s s_status "  status=")
	(set string s s_handle "  handle=")
	(set string s s_dim "  dim=")
	(set string s s_metric "  metric=")
	(set string s s_index "  index=")
	(set string s s_stored "stored documents: ")
	(set string s s_capacity "  capacity=")
	(set string s s_vsearch "semantic search for cars and driving:")
	(set string s s_tsearch "keyword search for index:")
	(set string s s_hsearch "hybrid search (vector food + text recipe):")
	(set string s s_hitid "  #")
	(set string s s_score "  score ")
	(set string s s_gap "   ")
	(set string s s_get "fetched record 3:  status=")
	(set string s s_plen "  payload bytes=")
	(set string s s_pyear "  payload year=")
	(set string s s_delete "deleted record 6:  status=")
	(set string s s_left "documents left: ")
	(set string s s_done "=== done ======================================================")

	// initialize the vecdb module
	(mod_vecdb :vecdb_init !)

	// get the memory addresses of arrays and strings
	(dbpathstr Ppath pointer)
	(vec1 Pvec1 pointer)
	(vec2 Pvec2 pointer)
	(vec3 Pvec3 pointer)
	(vec4 Pvec4 pointer)
	(vec5 Pvec5 pointer)
	(vec6 Pvec6 pointer)
	(qcar Pqcar pointer)
	(qfood Pqfood pointer)
	(textbuf Ptextbuf pointer)
	(payload Ppayload pointer)
	(plbuf Pplbuf pointer)

	// 1. open a database: exact (FLAT) index, cosine similarity
	(s_banner :print_s !)
	(:print_n !)
	(:print_n !)

	(Ppath dim metric index :vecdb_open !)
	(status stpopi)
	(handle stpopi)
	(s_opened :print_s !)
	(dbpathstr :print_s !)
	(:print_n !)
	(s_status :print_s !)
	(status :print_i !)
	(s_handle :print_s !)
	(handle :print_i !)
	(:print_n !)
	(s_dim :print_s !)
	(handle :vecdb_dim !)
	(tmp stpopi)
	(tmp :print_i !)
	(s_metric :print_s !)
	(handle :vecdb_metric !)
	(tmp stpopi)
	(tmp :print_i !)
	(s_index :print_s !)
	(handle :vecdb_index !)
	(tmp stpopi)
	(tmp :print_i !)
	(:print_n !)
	(:print_n !)

	// 2. insert the documents (id, vector, dim, payload, text)
	(handle id1 Pvec1 dim zero zero text1addr :vecdb_put !)
	(status stpopi)
	(handle id2 Pvec2 dim zero zero text2addr :vecdb_put !)
	(status stpopi)
	(handle id3 Pvec3 dim Ppayload payloadlen text3addr :vecdb_put !)
	(status stpopi)
	(handle id4 Pvec4 dim zero zero text4addr :vecdb_put !)
	(status stpopi)
	(handle id5 Pvec5 dim zero zero text5addr :vecdb_put !)
	(status stpopi)
	(handle id6 Pvec6 dim zero zero text6addr :vecdb_put !)
	(status stpopi)

	(s_stored :print_s !)
	(handle :vecdb_count !)
	(n stpopi)
	(n :print_i !)
	(s_capacity :print_s !)
	(handle :vecdb_capacity !)
	(tmp stpopi)
	(tmp :print_i !)
	(:print_n !)
	(:print_n !)

	// 3. semantic search: nearest neighbours of the "cars" query
	(s_vsearch :print_s !)
	(:print_n !)
	(handle Pqcar dim k :vecdb_search_vector !)
	(n stpopi)
	(zero i =)
	(for-loop)
	(((i n <) f =) f for)
		(s_hitid :print_s !)
		(i :vecdb_match_id !)
		(tmp stpopi)
		(tmp :print_i !)
		(s_score :print_s !)
		(i :vecdb_match_score !)
		(score stpopd)
		(score :print_d !)
		(s_gap :print_s !)
		(i Ptextbuf textbuflen :vecdb_match_text !)
		(status stpopi)
		(textbuf :print_s !)
		(:print_n !)
		((i one +) i =)
	(next)
	(:print_n !)

	// 4. keyword (BM25) search
	(s_tsearch :print_s !)
	(:print_n !)
	(handle qtext1addr k :vecdb_search_text !)
	(n stpopi)
	(zero i =)
	(for-loop)
	(((i n <) f =) f for)
		(s_hitid :print_s !)
		(i :vecdb_match_id !)
		(tmp stpopi)
		(tmp :print_i !)
		(s_score :print_s !)
		(i :vecdb_match_score !)
		(score stpopd)
		(score :print_d !)
		(s_gap :print_s !)
		(i Ptextbuf textbuflen :vecdb_match_text !)
		(status stpopi)
		(textbuf :print_s !)
		(:print_n !)
		((i one +) i =)
	(next)
	(:print_n !)

	// 5. hybrid search: 50% vector "food" + 50% text "recipe"
	(s_hsearch :print_s !)
	(:print_n !)
	(handle Pqfood dim qtext2addr k alpha :vecdb_search_hybrid !)
	(n stpopi)
	(zero i =)
	(for-loop)
	(((i n <) f =) f for)
		(s_hitid :print_s !)
		(i :vecdb_match_id !)
		(tmp stpopi)
		(tmp :print_i !)
		(s_score :print_s !)
		(i :vecdb_match_score !)
		(score stpopd)
		(score :print_d !)
		(s_gap :print_s !)
		(i Ptextbuf textbuflen :vecdb_match_text !)
		(status stpopi)
		(textbuf :print_s !)
		(:print_n !)
		((i one +) i =)
	(next)
	(:print_n !)

	// 6. fetch one record and read its payload back
	(handle id3 Pvec3 dim Pplbuf plbuflen Ptextbuf textbuflen :vecdb_get !)
	(status stpopi)
	(tmp stpopi)
	(s_get :print_s !)
	(status :print_i !)
	(s_plen :print_s !)
	(tmp :print_i !)
	(plbuf [ zero ] tmp =)
	(plbuf [ one ] tmp2 =)
	((tmp2 b256 *) tmp2 =)
	((tmp tmp2 +) tmp =)
	(s_pyear :print_s !)
	(tmp :print_i !)
	(:print_n !)
	(:print_n !)

	// 7. delete a document
	(handle id6 :vecdb_delete !)
	(status stpopi)
	(s_delete :print_s !)
	(status :print_i !)
	(:print_n !)
	(s_left :print_s !)
	(handle :vecdb_count !)
	(n stpopi)
	(n :print_i !)
	(:print_n !)
	(:print_n !)

	// 8. persist and close
	(handle :vecdb_flush !)
	(status stpopi)
	(handle :vecdb_close !)
	(status stpopi)
	(s_done :print_s !)
	(:print_n !)

	(zero :exit !)
(funcend)

#include <vecdb.l1h>
