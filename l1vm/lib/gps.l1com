// gps.l1com
#include <intr.l1h>
(main func)
	(set const-int64 1 zero 0)
	(set const-int64 1 one 1)
	(set const-int64 1 ret_err 5)
    (set int64 1 ret 0)
	(set int64 1 satellites 0)
	(set double 1 latitude 0.0)
	(set double 1 longitude 0.0)
	(set double 1 altitude 0.0)
	(set double 1 track 0.0)
	(set double 1 speed 0.0)
	(set string 31 timestr "")
	(set int64 1 f 0)
	(set const-int64 1 det 100)

	(set const-string s err_setupstr "error: can't set up GPS read!")
	(set const-string s satellitesstr "satellites: ")
	(set const-string s latitudestr "latitude: ")
	(set const-string s longitudestr "longitude: ")
	(set const-string s altitudestr "altitude: ")
    (set const-string s trackstr "track: ")
    (set const-string s speedstr "speed km/h: ")
    (set const-string s timeactstr "time: ")
    (set const-string s no_datastr "No GPS data! ")

    (set const-int64 1 gps_read_fail 5)
    (set const-string s gps_read_failstr "Read failing!")

    (set const-int64 1 gps_data_not_valid 3)
    (set const-string s gps_data_not_validstr "Data not valid!")

    (set const-int64 1 gps_no_fix 1)
    (set const-string s gps_no_fixstr "No 2D/3D fix!")

	(zero :gps_init !)
	(:gps_setup !)
	(ret stpop)
	(((ret zero !=) f :=) f if)
	    (err_setupstr :print_s !)
	    (:print_n !)
	    (one :exit !)
	(endif)

	// read GPS data loop
    (:loop)
	(timestr :gps_read !)
    (ret stpop)
    (latitude stpop)
    (longitude stpop)
    (altitude stpop)
    (track stpop)
    (speed stpop)
    (satellites stpop)
    (((ret zero !=) f :=) f if)
        (no_datastr :print_s !)
        (:print_n !)

        (((ret gps_read_fail ==) f :=) f if)
            (gps_read_failstr :print_s !)
        (endif)
        (((ret gps_data_not_valid ==) f :=) f if)
            (gps_data_not_validstr :print_s !)
        (endif)
        (((ret gps_no_fix ==) f :=) f if)
            (gps_no_fixstr :print_s !)
        (endif)
        (:print_n !)

        // delay
        (det :detime !)
        (:loop jmp)
    (endif)

    (timeactstr :print_s !)
    (timestr :print_s !)
    (:print_n !)

    (satellitesstr :print_s !)
    (satellites :print_i !)
    (:print_n !)

	(latitudestr :print_s !)
    (latitude :print_d !)
	(:print_n !)

	(longitudestr :print_s !)
    (longitude :print_d !)
	(:print_n !)

	(altitudestr :print_s !)
	(altitude :print_d !)
	(:print_n !)

	(trackstr :print_s !)
	(track :print_d !)
	(:print_n !)

	(speedstr :print_s !)
	(speed :print_d !)
	(:print_n !)
    (:print_n !)

	// delay
	(det :detime !)
	(:loop jmp)
(funcend)
#include <gps.l1h>
