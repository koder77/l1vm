//  bt-lib.l1com
//
//  bluetooth library 
//
(main func)
	(set int64 1 zero 0)
    (set int64 1 one 1)
    (set int64 1 mod_bt 0)
    (set int64 1 error 0)
    (set int64 1 f 0)
    (set int64 1 socket 0)
    (set string s error_open_btstr "open bluetooth: can't open!")
    (set string s error_acceptstr "open bluetooth: can't open accept connection!")
    (set string s error_readstr "open bluetooth: can't read string!")
    (set string 1024 buf)
    (mod_bt :bluetooth_init call)
    (loadreg)
    // open BT server
    (:bt_open_device_server call)
    (error stpopi)
    (socket stpopi)
    (((error zero !=) f =) f if)
		(6 error_open_btstr 0 0 intr0)
		(7 0 0 0 intr0)
		(:end jmp)
	(endif)
    (loadreg)
    (socket :bt_open_accept_server call)
    (error stpopi)
    (loadreg)
    (((error zero !=) f =) f if)
		(6 error_acceptstr 0 0 intr0)
		(7 0 0 0 intr0)
		(socket :bt_close_device_server call)
		(error stpopi)
		(loadreg)
		(:end jmp)
	(endif)
	// read string from BT socket
	(socket bufaddr :bt_read_string call)
	(error stpopi)
	(loadreg)
	(((error zero !=) f =) f if)
		(6 error_readstr 0 0 intr0)
		(7 0 0 0 intr0)
	(endif)
	// print string
	(6 buf 0 0 intr0)
	(7 0 0 0 intr0)
    // close BT sockets
    (socket :bt_close_accept_server call)
    (error stpopi)
    (loadreg)
    (socket :bt_close_device_server call)
    (error stpopi)
    (loadreg)
	(7 0 0 0 intr0)
	(:end)
    (1 mod_bt 0 0 intr0)
    (255 0 0 0 intr0)
(funcend)
// bluetooth library
//
//
(bluetooth_init func)
	(set string s modulestr@bt "libl1vmbluetooth")
	(set string s initstr@bt "init_bt_sockets")
	(set string s list_devicesstr@bt "bt_list_devices")
	(set string s open_device_serverstr@bt "bt_open_device_server")
	(set string s open_accept_serverstr@bt "bt_open_accept_server")
	(set string s open_device_clientstr@bt "bt_open_device_client")
	(set string s close_device_serverstr@bt "bt_close_device_server")
	(set string s close_accept_serverstr@bt "bt_close_accept_server")
	(set string s close_device_clientstr@bt "bt_close_device_client")
	(set string s read_stringstr@bt "bt_read_string")
	(set string s write_stringstr@bt "bt_write_string")
	(set string s read_bytestr@bt "bt_read_byte")
	(set string s write_bytestr@bt "bt_write_byte")
	(set int64 1 init@bt 0)
	(set int64 1 list_devices@bt 1)
	(set int64 1 open_device_server@bt 2)
	(set int64 1 open_accept_server@bt 3)
	(set int64 1 open_device_client@bt 4)
	(set int64 1 close_device_server@bt 5)
	(set int64 1 close_accept_server@bt 6)
	(set int64 1 close_device_client@bt 7)
	(set int64 1 read_string@bt 8)
	(set int64 1 write_string@bt 9)
	(set int64 1 read_byte@bt 10)
	(set int64 1 write_byte@bt 11)
	(set int64 1 mod@bt 0)
	// get arguments from stack
	(mod@bt stpopi)
	// load BT module
    (0 modulestr@btaddr mod@bt 0 intr0)
	// set functions
	(2 mod@bt init@bt initstr@btaddr intr0)
	(2 mod@bt list_devices@bt list_devicesstr@btaddr intr0)
	(2 mod@bt open_device_server@bt open_device_serverstr@btaddr intr0)
	(2 mod@bt open_accept_server@bt open_accept_serverstr@btaddr intr0)
	(2 mod@bt open_device_client@bt open_device_clientstr@btaddr intr0)
	(2 mod@bt close_device_server@bt close_device_serverstr@btaddr intr0)
	(2 mod@bt close_accept_server@bt close_accept_serverstr@btaddr intr0)
	(2 mod@bt close_device_client@bt close_device_clientstr@btaddr intr0)
	(2 mod@bt read_string@bt read_stringstr@btaddr intr0)
	(2 mod@bt write_string@bt write_stringstr@btaddr intr0)
	(2 mod@bt read_byte@bt read_bytestr@btaddr intr0)
	(2 mod@bt write_byte@bt write_bytestr@btaddr intr0)
	// init library
	(3 mod@bt init@bt 0 intr0)
(funcend)
// wrapper functions
//
(bt_list_devices func)
	(3 mod@bt list_devices@bt 0 intr0)
(funcend)
(bt_open_device_server func)
    (3 mod@bt open_device_server@bt 0 intr0)
(funcend)
(bt_open_accept_server func)
    (3 mod@bt open_accept_server@bt 0 intr0)
(funcend)
(bt_open_device_client func)
    (3 mod@bt open_device_client@bt 0 intr0)
(funcend)
(bt_close_device_server func)
    (3 mod@bt close_device_server@bt 0 intr0)
(funcend)
(bt_close_accept_server func)
    (3 mod@bt close_accept_server@bt 0 intr0)
(funcend)
(bt_close_device_client func)
    (3 mod@bt close_device_client@bt 0 intr0)
(funcend)
(bt_read_string func)
	(3 mod@bt read_string@bt 0 intr0)
(funcend)
(bt_write_string func)
	(3 mod@bt write_string@bt 0 intr0)
(funcend)
(bt_read_byte func)
	(3 mod@bt read_byte@bt 0 intr0)
(funcend)
(bt_write_byte func)
	(3 mod@bt write_byte@bt 0 intr0)
(funcend)
