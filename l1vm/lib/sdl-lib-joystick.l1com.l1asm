:main
loada zero, 0, 0
stpushi 0
loada zero, 0, 1
stpushi 1
loada width, 0, 2
stpushi 2
loada height, 0, 3
stpushi 3
loada bit, 0, 4
stpushi 4
jsr :sdl_open_screen
stpopi 5
load ret, 0, 6
pullqw 5, 6, 0
stpopi 0
loada joy_namestraddr, 0, 1
stpushi 1
loada joy_name_len, 0, 2
stpushi 2
jsr :sdl_get_joystick_info
stpopi 3
load joy_axis_max, 0, 4
pullqw 3, 4, 0
stpopi 4
load joy_buttons_max, 0, 5
pullqw 4, 5, 0
loada joy_name_infostraddr, 0, 1
intr0 6, 1, 0, 0
loada joy_namestraddr, 0, 2
intr0 6, 2, 0, 0
intr0 7, 0, 0, 0
:loop
stpushi 1
stpushi 2
jsr :sdl_get_joystick_x_axis
stpopi 3
load joy_x_axis, 0, 4
pullqw 3, 4, 0
stpopi 2
stpopi 1
jsr :sdl_get_joystick_y_axis
stpopi 1
load joy_y_axis, 0, 2
pullqw 1, 2, 0
loada joy_axis_max, 0, 1
loada two, 0, 2
gri 1, 2, 3
load f, 0, 4
pullqw 3, 4, 0
loada f, 0, 5
jmpi 5, :if_0
jmp :endif_0
:if_0
stpushi 1
stpushi 2
stpushi 3
stpushi 4
stpushi 5
jsr :sdl_get_joystick_x2_axis
stpopi 6
load joy_x2_axis, 0, 7
pullqw 6, 7, 0
stpopi 5
stpopi 4
stpopi 3
stpopi 2
stpopi 1
jsr :sdl_get_joystick_y2_axis
stpopi 1
load joy_y2_axis, 0, 2
pullqw 1, 2, 0
:endif_0
loada joy_button, 0, 1
stpushi 1
jsr :sdl_get_joystick_button
stpopi 2
load joy_button_state, 0, 3
pullqw 2, 3, 0
loada joy_x_axisstraddr, 0, 1
intr0 6, 1, 0, 0
loada joy_x_axis, 0, 2
intr0 4, 2, 0, 0
intr0 7, 0, 0, 0
loada joy_y_axisstraddr, 0, 3
intr0 6, 3, 0, 0
loada joy_y_axis, 0, 4
intr0 4, 4, 0, 0
intr0 7, 0, 0, 0
loada joy_axis_max, 0, 5
loada two, 0, 6
gri 5, 6, 7
load f, 0, 8
pullqw 7, 8, 0
loada f, 0, 9
jmpi 9, :if_1
jmp :endif_1
:if_1
loada joy_x2_axisstraddr, 0, 10
intr0 6, 10, 0, 0
loada joy_x2_axis, 0, 11
intr0 4, 11, 0, 0
intr0 7, 0, 0, 0
loada joy_y2_axisstraddr, 0, 12
intr0 6, 12, 0, 0
loada joy_y2_axis, 0, 13
intr0 4, 13, 0, 0
intr0 7, 0, 0, 0
:endif_1
loada button_straddr, 0, 14
intr0 6, 14, 0, 0
loada joy_button_state, 0, 15
intr0 4, 15, 0, 0
intr0 7, 0, 0, 0
intr0 7, 0, 0, 0
jmp :loop
rts
