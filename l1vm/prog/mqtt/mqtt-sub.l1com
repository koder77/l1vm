// mqtt-sub.l1com - mqtt receive message demo
//
//
#include <intr-func.l1h>
(main func)
    (set const-int64 1 zero 0)
    (set const-int64 1 one 1)
    (set const-int64 1 mqtt_mod 0)
    (set const-string s clientaddressstr "tcp://localhost:1883")
    (set const-string s clientidstr "ExampleClientSub")
    (set const-string s topicstr "MQTT Examples")
    (set const-string s error_open_clientstr "error: can't open mqtt client")
    (set const-string s msg_module_loadstr "mqtt module load!")
    (set const-string s error_read_msgstr "error: can't read message!")
    (set const-string s msg_client_openstr "client socket opened")
    (set string 4097 messagestr "")
    (set int64 1 mqtt_handle 0)
    (set int64 1 qos 1)
    (set int64 1 ret 0)
    (set int64 1 f 0)

    (mqtt_mod :mqtt_init !)

    (msg_module_loadstr :print_s !)
    (:print_n !)

    (clientaddressstr clientidstr topicstr qos messagestr :mqtt_open_client !)
    (mqtt_handle stpop)
    (((mqtt_handle zero <) f :=)n f if)
       (error_open_clientstr :print_s !)
       (:print_n !)
       (one :exit !)
    (endif)

    (msg_client_openstr :print_s !)
    (:print_n !)

    (:read)
    (mqtt_handle :mqtt_get_msg !)
    (ret stpop)
    (((ret one !=) f :=) f if)
        //(error_read_msgstr :print_s !)
        //(:print_n !)
        (:read jmp)
    (endif)

    (messagestr :print_s !)
    (:print_n !)

    (mqtt_handle :mqtt_close_client !)

    (zero :exit !)
(funcend)
#include <mqtt.l1h>
