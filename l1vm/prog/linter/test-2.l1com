// math-inc-strict.l1com
//
// contracts: precondition/postcondition demo
// Define function as strict. With the "S" flag.
// Only variables with an "R" ending are alowed as return values.
// They are forbidden as function call arguments.
//
// (func args S incP int64)
// (return args incP int64 int64)
//
// (func args S testP int64)
// (return args testP int64 int64)

// (func-strict)

(linter)

#include <intr-func.l1h>

(main func)
	(set const-int64 1 zero 0)
    (set const-int64 1 one 1)
    (set int64 1 x 42)
    (set int64 1 incxR 0)
    (set int64 1 f 0)
    (set int64 1 retR 0)
    (set const-string s error_inc_str "inc: error!")

    (x :incP !) (retR incxR stpop)
    (((retR zero !=) f :=) f if)
        (error_inc_str :print_s !)
        (:print_n !)
        (one :exit !)
    (endif)

    (incxR :print_i !)
    (:print_n !)

    (x :testP !) (retR incxR stpop)
    (((retR zero !=) f :=) f if)
        (error_inc_str :print_s !)
        (:print_n !)
        (one :exit !)
    (endif)

    (zero :exit !)
(funcend)

(variable-local-only-on)

(incP func)
    #var ~ incP
    (set int64 1 num~ 0)
    (set int64 1 ret~ 0)
    (set int64 1 check~ 0)
    (set const-int64 1 zero~ 0)
    (set const-int64 1 one~ 1)
    (set int64 1 f~ 0)
    (set const-int64 1 int64-max~ 9223372036854775807)
    (set const-string s overflow_str~ "inc: error number overflow!")
    (set const-string s error_int_str~ "inc: error internal!")

    (num~ stpop)

    (num~ + one~ ret~ :=)

    (ret~ zero~ stpush) (return)
(funcend)
(testP func)
    #var ~ testP
    (set int64 1 num~ 0)
    (set int64 1 ret~ 0)
    (set int64 1 check~ 0)
    (set const-int64 1 zero~ 0)
    (set const-int64 1 one~ 1)
    (set int64 1 f~ 0)
    (set const-int64 1 int64-max~ 9223372036854775807)
    (set const-string s overflow_str~ "inc: error number overflow!")
    (set const-string s error_int_str~ "inc: error internal!")

    (num~ stpop)

    (num~ + one~ ret~ :=)

    (ret~ zero~ stpush) (return)
(funcend)
