// pthread-2.l1com
// threading test
#include <intr-func.l1h>
#include <misc-macros.l1h>
#include <math-const.l1h>
(main func)
    (set int64 1 zero 0)
    (set int64 1 one 1)
    (set int64 1 two 2)
    (set int64 1 ret 0)
    (set int64 1 f 0)
    (set int64 1 thralab 0)
    (set int64 1 thrblab 0)
    (set int64 1 cpuid 0)
    (set string s msgthrstr "starting Threads...")
    (set int64 1 thrastart 0)
    (set int64 1 thrbstart 0)

    (:thra thralab loadl)
    (:thrb thrblab loadl)
    (thralab + zero thralab :=)
    (thrblab + zero thrblab :=)

    (cpuid :get_cpu !)
    (cpuid + zero cpuid :=)
    (((cpuid zero ==) f =) f if)
        (msgthrstr :print_s !)
        (:print_n !)

        (thralab :thread !)
        (thrblab :thread !)
    (endif)

    (:join !)

    (zero :exit !)
(funcend)

(thra func)
    #var ~ thra

    (set int64 1 zero~ 0)
    (set int64 1 run~)
    (set int64 1 retcode~ 0)
    (set string s hellostr~ "Hello from a!")
    (set int64 1 thr1lab~ 0)
    (set int64 1 thr2lab~ 0)
    (set int64 1 vcpu~ 0)
    (set int64 1 del~ 1000)
    (set int64 1 f~ 0)

    (((thrastart zero~ ==) f~ =) f if)
    (one thrastart :=)

    (:thra1 thr1lab~ loadl)
    (:thra2 thr2lab~ loadl)

    (thr1lab~ + zero thr1lab~ :=)
    (thr2lab~ + zero thr2lab~ :=)

    (hellostr~ :print_s !)
    (:print_n !)

    (thr1lab~, vcpu~ :vcpu_RUN !)
    (del~ :detime !)
    (thr2lab~, vcpu~ :vcpu_RUN !)
    (del~ :detime !)

    (:wait_thra)
    (run~ :vcpu_JOIN !)
    (run~ + zero run~ :=)

    (((run~ zero~ ==) f~ =) f~ if+)
        (zero~ :threadexit !)
    (else)
        (:wait_thra jmp)
    (endif)
    (endif)
(funcend)

(thrb func)
    #var ~ thrb

    (set int64 1 zero~ 0)
    (set int64 1 run~)
    (set int64 1 retcode~ 0)
    (set string s hellostr~ "Hello from b!")
    (set int64 1 thr1lab~ 0)
    (set int64 1 thr2lab~ 0)
    (set int64 1 vcpu~ 0)
    (set int64 1 del~ 1000)
    (set int64 1 f~ 0)

    (((thrbstart zero~ ==) f~ =) f if)
    (one thrbstart :=)

    (:thrb1 thr1lab~ loadl)
    (:thrb2 thr2lab~ loadl)

    (thr1lab~ + zero thr1lab~ :=)
    (thr2lab~ + zero thr2lab~ :=)

    (hellostr~ :print_s !)
    (:print_n !)

    (thr1lab~, vcpu~ :vcpu_RUN !)
    (del~ :detime !)
    (thr2lab~, vcpu~ :vcpu_RUN !)
    (del~ :detime !)

    (:wait_thrb)
    (run~ :vcpu_JOIN !)
    (run~ + zero run~ :=)

    (((run~ zero~ ==) f~ =) f~ if+)
        (zero~ :threadexit !)
    (else)
        (:wait_thrb jmp)
    (endif)
    (endif)
(funcend)

// vcpu threads
(thra1 func)
    #var ~ thra1
    (set string s hellostr~ "thra1 Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
    (set int64 1 f~ 0)
    (zero i~ :=)
    //(cpu~ stpop)
    (:print_a1_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_a1_loop jmp)
    (endif)
    (:vcpu_EXIT !)
(funcend)

(thra2 func)
    #var ~ thra2
    (set string s hellostr~ "thra2 Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
