    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_a2_loop jmp)
    (endif)
    (:vcpu_EXIT !)
(funcend)

(thrb1 func)
    #var ~ thrb1
    (set string s hellostr~ "thrb1 Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
    (set int64 1 f~ 0)
    (zero i~ :=)
    //(cpu~ stpop)
    (:print_b1_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_b1_loop jmp)
    (endif)
    (:vcpu_EXIT !)
(funcend)

(thrb2 func)
    #var ~ thrb2
    (set string s hellostr~ "thrb2 Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
    (set int64 1 f~ 0)
    (zero i~ :=)
    //(cpu~ stpop)
    (:print_b2_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_b2_loop jmp)
