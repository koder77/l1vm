// hello-sched-3.l1om
#include <intr-func.l1h>
(main func)
    (set int64 1 zero 0)
    (set int64 1 one 1)
    (set int64 1 run 0)
    (set int64 1 f 0)
    (set int64 1 vcpu 0)
    (set int64 1 print_a_lab 0)
    (set int64 1 print_b_lab 0)
    (set string s statusstr "CPU status: ")
    (set string s current_cpustr "CPU current: ")
    (set string s estr "EXIT!")
    (set int64 1 scheduler_max 500)
    (set int64 1 cpu 0)
    (scheduler_max :vcpu_SCHEDULERMAX !)

    (:print_a print_a_lab loadl)
    (print_a_lab + zero print_a_lab :=)

    (:print_b print_b_lab loadl)
    (print_b_lab + zero print_b_lab :=)

    (cpu :get_cpu !)
    (cpu + zero cpu :=)
    (:print_n !)
    (current_cpustr :print_s !)
    (cpu :print_i !)
    (:print_n !)
    (((cpu zero ==) f =) f if)
        (zero stpush)
        (print_a_lab :thread !)
        (one stpush)
        (print_b_lab :thread !)
    (endif)
    (:join !)
    (zero :exit !)
(funcend)

(print_a func)
    #var ~ print_a
    (set string s hellostr~ "Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 100)
    (set int64 1 f~ 0)
    (zero i~ :=)
    (cpu~ stpop)
    (:print_a_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_a_loop jmp)
    (endif)
    (zero :threadexit !)
(funcend)

(print_b func)
    #var ~ print_b
    (set string s hellostr~ "Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 100)
    (set int64 1 f~ 0)
    (zero i~ :=)
    (cpu~ stpop)
    (:print_b_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_b_loop jmp)
    (endif)
    (zero :threadexit !)
(funcend)
