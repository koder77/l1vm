// hello-sched-2.l1om
//
// This is an exammple how to launch threads using inline assembly.
//
#include <intr-func.l1h>
(main func)
    (set int64 1 zero 0)
    (set int64 1 one 1)
    (set int64 1 run 0)
    (set int64 1 f 0)
    (set int64 1 vcpu1 1)
    (set int64 1 vcpu2 2)
    (set int64 1 print_a_lab 0)
    (set int64 1 print_b_lab 0)
    (set string s statusstr "CPU status: ")
    (set string s estr "EXIT!")
    (set int64 1 scheduler_max 500)

    (scheduler_max :vcpu_SCHEDULERMAX !)

    (:print_a print_a_lab loadl)
    (print_a_lab + zero print_a_lab :=)

    (:print_b print_b_lab loadl)
    (print_b_lab + zero print_b_lab :=)

    (vcpu1 stpush)
    (print_a_lab, vcpu1 :vcpu_RUN !)
    (vcpu2 stpush)
    (print_b_lab, vcpu2 :vcpu_RUN !)

    (:wait)
    (run :vcpu_JOIN !)
    (run + zero run :=)
    //(statusstr :print_s !)
    // (run :print_i !)
    //(:print_n !)
    (((run zero ==) f =) f if+)
       (:print_n !)
       (estr :print_s !)
       (:print_n !)

       (zero :exit !)
   (else)
       (:wait jmp)
   (endif)
(funcend)

(print_a func)
    #var ~ print_a
    (set string s hellostr~ "Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
    (set int64 1 f~ 0)
    (zero i~ :=)
    (cpu~ stpop)
    (:print_a_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_a_loop jmp)
    (endif)
    (:vcpu_EXIT !)
(funcend)

(print_b func)
    #var ~ print_b
    (set string s hellostr~ "Hello world: CPU ")
    (set string s countstr~ " count: ")
    (set int64 1 cpu~ 0)
    (set int64 1 i~ 0)
    (set int64 1 max~ 1000000)
    (set int64 1 f~ 0)
    (zero i~ :=)
    (cpu~ stpop)
    (:print_b_loop)
    (hellostr~ :print_s !)
    (cpu~ :print_i !)
    (countstr~ :print_s !)
    (i~ :print_i !)
    (:print_n !)
    (i~ + one i~ :=)
    (((i~ max~ <) f~ :=) f~ if)
        (:print_b_loop jmp)
    (endif)
    (:vcpu_EXIT !)
(funcend)
