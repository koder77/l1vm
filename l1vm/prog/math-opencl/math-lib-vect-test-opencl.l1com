// math-lib-vect.l1com
#include <intr-func.l1h>
(main func)
	(set const-int64 1 zero 0)
	(set const-int64 1 max 9999999)
	(set int64 10000000 av)
	(set int64 10000000 bv)
	(set int64 10000000 cv)
	(set int64 1 Pav 0)
	(set int64 1 Pbv 0)
	(set int64 1 Pcv 0)
	(set int64 1 i 0)
	(set const-int64 1 offset 8)
	(set int64 1 real_ind 0)
	(set int64 1 f 0)
	(set int64 1 x 0)
	(set int64 1 one 1)

    (set int64 1 time_ms_i 0)
    (set const-int64 1 slot0 0)
    (set const-int64 1 slot1 1)
    (set const-int64 1 slot2 2)

	(zero :oclmath_vect_init !)

    // init array
    (((i max <) f =) f for)
         (i av [ real_ind ] =)
         (i bv [ real_ind ] =)

         ((real_ind offset +) real_ind :=)
         (i + one i :=)
    (next)

    (av Pav pointer)
    (Pav + zero Pav :=)

    (bv Pbv pointer)
    (Pbv + zero Pbv :=)

    (cv Pcv pointer)
    (Pcv + zero Pcv :=)

    (zero real_ind :=)
    (zero i :=)
    (:start_timer !)
    // new functions copy array to OpenCL data structure slots:
    (Pav slot0 zero max :oclmath_push !)
    (Pbv slot1 zero max :oclmath_push !)
    // do calculation on slots
	(slot0 slot1 zero max slot2 :oclvmath_mul_int_array !)
    // do pull OpenCL array into Pcv array!:
    (slot2 Pcv zero max :oclmath_pull !)
    (25 time_ms_i 0 0 intr0)
    (time_ms_i :print_i !)
    (:print_n !)
    (zero :exit !)

	// print cv array
	(:loop)
	(cv [ real_ind ] x =)
    (x :print_i !)
    (:print_n !)
	((real_ind offset +) real_ind :=)
	((i one +) i :=)
	(((i max <) f :=) f if)
		(:loop jmp)
	(endif)
    (:oclvmath_shutdown !)
	// close module
	(zero :free_mod !)
	(zero :exit !)
(funcend)
#include <math-lib-vect-opencl.l1h>
