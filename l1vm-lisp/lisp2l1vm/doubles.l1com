(:main jmp)
#include <intr-func.l1h>

(main func)
    #var ~ main
    (set int64 1 zero 0)
    (set int64 1 mathmod 1)
    (zero :string_init !)
    (mathmod :math_init !)
    (set string s lit3 "literal")
    (set int64 1 lit4 1)
    (set string s lit5 "add")
    (set string s lit6 "mixed add")
    (set string s lit7 "mul")
    (set string s lit8 "mixed div")
    (set string s lit9 "mod")
    (set double 1 lit10 7.5)
    (set double 1 lit11 2.0)
    (set double 1 lit12 1.5)
    (set string s lit13 "chain")
    (set string s lit14 "eq")
    (set string s lit15 "mixed eq")
    (set string s lit16 "not equal")
    (set string s lit17 "chained cmp")
    (set string s lit18 "double?")
    (set string s lit19 "integer?")
    (set string s lit21 "number?")
    (set string s lit23 "int->double")
    (set int64 1 lit24 7)
    (set double 1 lit25 7.0)
    (set string s lit26 "double->int")
    (set double 1 lit27 7.9)
    (set double 1 lit28 0.0)
    (set string s lit29 "neg conv")
    (set double 1 lit30 -2.7)
    (set int64 1 lit31 -2)
    (set string s lit32 "trailing dot")
    (set string s lit33 "leading dot")
    (set string s lit34 "exponent")
    (set string s lit35 "doubles done")
    (set string s lit37 "ok   ")
    (set string s lit38 "FAIL ")
    (lit4 lit3addr :check !)
    (set int64 1 discard1~ 0)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit5addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit6addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit7addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit8addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (set double 1 t2~ 0.0)
    (lit10 lit11 :math_fmoddouble !)
    (t2~ stpopd)
    (reset-reg)
    (set int64 1 t3~ 0)
    ((t2~ lit12 ==d) t3~ =)
    (t3~ lit9addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit13addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit14addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit15addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit16addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit17addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit18addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit19addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit21addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (set double 1 t4~ 0.0)
    (lit24 :math_int2double !)
    (t4~ stpopd)
    (reset-reg)
    (set int64 1 t5~ 0)
    ((t4~ lit25 ==d) t5~ =)
    (t5~ lit23addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (set int64 1 t6~ 0)
    (set double 1 t7~ 0.0)
    (set int64 1 t8~ 0)
    ((lit27 lit28 >=d) t8~ =)
    (t8~ if+)
        (lit27 :math_floordouble !)
        (t7~ stpopd)
        (reset-reg)
    (else)
        (lit27 :math_ceildouble !)
        (t7~ stpopd)
        (reset-reg)
    (endif)
    (t7~ :math_double2int !)
    (t6~ stpopi)
    (reset-reg)
    (set int64 1 t9~ 0)
    (t6~ == lit24 t9~ :=)
    (t9~ lit26addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (set int64 1 t10~ 0)
    (set double 1 t11~ 0.0)
    (set int64 1 t12~ 0)
    ((lit30 lit28 >=d) t12~ =)
    (t12~ if+)
        (lit30 :math_floordouble !)
        (t11~ stpopd)
        (reset-reg)
    (else)
        (lit30 :math_ceildouble !)
        (t11~ stpopd)
        (reset-reg)
    (endif)
    (t11~ :math_double2int !)
    (t10~ stpopi)
    (reset-reg)
    (set int64 1 t13~ 0)
    (t10~ == lit31 t13~ :=)
    (t13~ lit29addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit32addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit33addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit34addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit35 :print_s !)
    (:print_n !)
    (zero :free_mod !)
    (zero :exit !)
(funcend)

(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (lit37 :print_s !)
    (set string 4096 sb2~ "")
    (sb2~ label~ :string_copy !)
    (sb2~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (lit38 :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)


#include <string.l1h>

#include <math-const.l1h>
#include <math-lib.l1h>
