(:main jmp)
#include <intr-func.l1h>

(main func)
    #var ~ main
    (set int64 1 zero 0)
    (set int64 1 l2v_sdlmod 4)
    (set int64 1 l2v_sdl_pixel_r 0)
    (set int64 1 l2v_sdl_pixel_g 0)
    (set int64 1 l2v_sdl_pixel_b 0)
    (set int64 1 l2v_sdl_pixel_a 0)
    (set int64 1 l2v_sdl_mouse_x 0)
    (set int64 1 l2v_sdl_mouse_y 0)
    (set int64 1 l2v_sdl_mouse_left 0)
    (set int64 1 l2v_sdl_mouse_middle 0)
    (set int64 1 l2v_sdl_mouse_right 0)
    (set int64 1 l2v_sdl_joy_axis 0)
    (set int64 1 l2v_sdl_joy_buttons 0)
    (set int64 1 l2v_sdl_gadget_x2 0)
    (set int64 1 l2v_sdl_gadget_y2 0)
    (set int64 1 l2v_sdl_gadget_value 0)
    (set int64 1 l2v_sdl_gadget_status 0)
    (zero :string_init !)
    (set int64 1 lit3 4)
    (set int64 1 lit4 320)
    (set int64 1 lit5 240)
    (set int64 1 lit6 32)
    (set int64 1 lit7 0)
    (set string s lit8 "open screen")
    (set string s lit9 "lisp2l1vm SDL 3.0 test")
    (set int64 1 lit10 10)
    (set int64 1 lit11 255)
    (set int64 1 lit12 20)
    (set int64 1 lit13 80)
    (set int64 1 lit14 30)
    (set int64 1 lit15 60)
    (set int64 1 lit16 70)
    (set int64 1 lit17 90)
    (set int64 1 lit18 40)
    (set int64 1 lit19 120)
    (set int64 1 lit20 140)
    (set int64 1 lit21 15)
    (set int64 1 lit23 150)
    (set int64 1 lit24 200)
    (set int64 1 lit25 180)
    (set int64 1 lit26 50)
    (set int64 1 lit27 220)
    (set int64 1 lit28 100)
    (set int64 1 lit29 160)
    (set int64 1 lit30 130)
    (set string s lit31 "draw primitives")
    (set int64 1 lit32 1)
    (set string s lit33 "get pixel color")
    (set string s lit34 "get mouse state")
    (set string s lit35 "joystick")
    (set string s lit36 "get joystick info")
    (set string s lit37 "get key")
    (set int64 1 lit38 -1)
    (set string s lit39 "gui allocate/free")
    (set string s lit40 "sdl-3.0 done")
    (set string s lit42 "ok   ")
    (set string s lit43 "FAIL ")
    (lit3 stpushi)
    (lit4 stpushi)
    (lit5 stpushi)
    (lit6 stpushi)
    (lit7 stpushi)
    (lit3 lit4 lit5 lit6 lit7 :sdl_open_screen !)
    (set int64 1 t1~ 0)
    (t1~ stpopi)
    (reset-reg)
    (set int64 1 screen 0)
    (t1~ screen :=)
    (set int64 1 t2~ 0)
    (screen == lit7 t2~ :=)
    (t2~ lit8addr :check !)
    (set int64 1 discard3~ 0)
    (discard3~ stpopi)
    (reset-reg)
    (lit9addr stpushi)
    (lit9addr :sdl_set_window_title !)
    (reset-reg)
    (set byte 1 by4~ 255)
    (set byte 1 by5~ 0)
    (set byte 1 by6~ 0)
    (set byte 1 by7~ 255)
    (lit10 stpushi)
    (lit10 stpushi)
    (by4~ stpushb)
    (by5~ stpushb)
    (by6~ stpushb)
    (by7~ stpushb)
    (lit10 lit10 by4~ by5~ by6~ by7~ :sdl_pixel !)
    (reset-reg)
    (set byte 1 by8~ 0)
    (set byte 1 by9~ 255)
    (set byte 1 by10~ 0)
    (set byte 1 by11~ 255)
    (lit12 stpushi)
    (lit12 stpushi)
    (lit13 stpushi)
    (lit12 stpushi)
    (by8~ stpushb)
    (by9~ stpushb)
    (by10~ stpushb)
    (by11~ stpushb)
    (lit12 lit12 lit13 lit12 by8~ by9~ by10~ by11~ :sdl_line !)
    (reset-reg)
    (set byte 1 by12~ 0)
    (set byte 1 by13~ 0)
    (set byte 1 by14~ 255)
    (set byte 1 by15~ 255)
    (lit12 stpushi)
    (lit14 stpushi)
    (lit13 stpushi)
    (lit15 stpushi)
    (by12~ stpushb)
    (by13~ stpushb)
    (by14~ stpushb)
    (by15~ stpushb)
    (lit12 lit14 lit13 lit15 by12~ by13~ by14~ by15~ :sdl_rectangle !)
    (reset-reg)
    (set byte 1 by16~ 255)
    (set byte 1 by17~ 255)
    (set byte 1 by18~ 0)
    (set byte 1 by19~ 255)
    (lit14 stpushi)
    (lit16 stpushi)
    (lit16 stpushi)
    (lit17 stpushi)
    (by16~ stpushb)
    (by17~ stpushb)
    (by18~ stpushb)
    (by19~ stpushb)
    (lit14 lit16 lit16 lit17 by16~ by17~ by18~ by19~ :sdl_rectangle_fill !)
    (reset-reg)
    (set byte 1 by20~ 255)
    (set byte 1 by21~ 0)
    (set byte 1 by22~ 255)
    (set byte 1 by23~ 255)
    (lit18 stpushi)
    (lit19 stpushi)
    (lit12 stpushi)
    (by20~ stpushb)
    (by21~ stpushb)
    (by22~ stpushb)
    (by23~ stpushb)
    (lit18 lit19 lit12 by20~ by21~ by22~ by23~ :sdl_circle !)
    (reset-reg)
    (set byte 1 by24~ 0)
    (set byte 1 by25~ 255)
    (set byte 1 by26~ 255)
    (set byte 1 by27~ 255)
    (lit17 stpushi)
    (lit19 stpushi)
    (lit12 stpushi)
    (by24~ stpushb)
    (by25~ stpushb)
    (by26~ stpushb)
    (by27~ stpushb)
    (lit17 lit19 lit12 by24~ by25~ by26~ by27~ :sdl_circle_fill !)
    (reset-reg)
    (set byte 1 by28~ 255)
    (set byte 1 by29~ 128)
    (set byte 1 by30~ 0)
    (set byte 1 by31~ 255)
    (lit20 stpushi)
    (lit19 stpushi)
    (lit14 stpushi)
    (lit21 stpushi)
    (by28~ stpushb)
    (by29~ stpushb)
    (by30~ stpushb)
    (by31~ stpushb)
    (lit20 lit19 lit14 lit21 by28~ by29~ by30~ by31~ :sdl_ellipse !)
    (reset-reg)
    (set byte 1 by32~ 128)
    (set byte 1 by33~ 255)
    (set byte 1 by34~ 0)
    (set byte 1 by35~ 255)
    (lit20 stpushi)
    (lit23 stpushi)
    (lit14 stpushi)
    (lit21 stpushi)
    (by32~ stpushb)
    (by33~ stpushb)
    (by34~ stpushb)
    (by35~ stpushb)
    (lit20 lit23 lit14 lit21 by32~ by33~ by34~ by35~ :sdl_ellipse_fill !)
    (reset-reg)
    (set byte 1 by36~ 0)
    (set byte 1 by37~ 128)
    (set byte 1 by38~ 255)
    (set byte 1 by39~ 255)
    (lit24 stpushi)
    (lit19 stpushi)
    (lit14 stpushi)
    (lit7 stpushi)
    (lit17 stpushi)
    (by36~ stpushb)
    (by37~ stpushb)
    (by38~ stpushb)
    (by39~ stpushb)
    (lit24 lit19 lit14 lit7 lit17 by36~ by37~ by38~ by39~ :sdl_pie !)
    (reset-reg)
    (set byte 1 by40~ 255)
    (set byte 1 by41~ 0)
    (set byte 1 by42~ 128)
    (set byte 1 by43~ 255)
    (lit24 stpushi)
    (lit19 stpushi)
    (lit14 stpushi)
    (lit17 stpushi)
    (lit25 stpushi)
    (by40~ stpushb)
    (by41~ stpushb)
    (by42~ stpushb)
    (by43~ stpushb)
    (lit24 lit19 lit14 lit17 lit25 by40~ by41~ by42~ by43~ :sdl_pie_fill !)
    (reset-reg)
    (set byte 1 by44~ 255)
    (set byte 1 by45~ 0)
    (set byte 1 by46~ 0)
    (set byte 1 by47~ 255)
    (lit12 stpushi)
    (lit25 stpushi)
    (lit13 stpushi)
    (lit25 stpushi)
    (lit26 stpushi)
    (lit27 stpushi)
    (by44~ stpushb)
    (by45~ stpushb)
    (by46~ stpushb)
    (by47~ stpushb)
    (lit12 lit25 lit13 lit25 lit26 lit27 by44~ by45~ by46~ by47~ :sdl_trigon !)
    (reset-reg)
    (set byte 1 by48~ 0)
    (set byte 1 by49~ 255)
    (set byte 1 by50~ 0)
    (set byte 1 by51~ 255)
    (lit28 stpushi)
    (lit25 stpushi)
    (lit29 stpushi)
    (lit25 stpushi)
    (lit30 stpushi)
    (lit27 stpushi)
    (by48~ stpushb)
    (by49~ stpushb)
    (by50~ stpushb)
    (by51~ stpushb)
    (lit28 lit25 lit29 lit25 lit30 lit27 by48~ by49~ by50~ by51~ :sdl_trigon_fill !)
    (reset-reg)
    (lit32 lit31addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (:sdl_update !)
    (reset-reg)
    (lit10 stpushi)
    (lit10 stpushi)
    (lit10 lit10 :l2v_sdl_get_pixelcolor !)
    (set int64 1 t52~ 0)
    (t52~ stpopi)
    (reset-reg)
    (set int64 1 red 0)
    (t52~ red :=)
    (set int64 1 t53~ 0)
    (red == lit11 t53~ :=)
    (t53~ lit33addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (:l2v_sdl_get_mouse_state !)
    (set int64 1 t54~ 0)
    (t54~ stpopi)
    (reset-reg)
    (set int64 1 mouse_x 0)
    (t54~ mouse_x :=)
    (set int64 1 t55~ 0)
    (mouse_x >= lit7 t55~ :=)
    (t55~ lit34addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (set int64 1 joy_name 0)
    (lit35addr joy_name :=)
    (joy_name stpushi)
    (joy_name :l2v_sdl_get_joystick_info !)
    (set int64 1 t56~ 0)
    (t56~ stpopi)
    (reset-reg)
    (set int64 1 axes 0)
    (t56~ axes :=)
    (set int64 1 t57~ 0)
    (axes >= lit7 t57~ :=)
    (t57~ lit36addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (:sdl_get_key !)
    (set int64 1 t58~ 0)
    (t58~ stpopi)
    (reset-reg)
    (set int64 1 key 0)
    (t58~ key :=)
    (set int64 1 t59~ 0)
    (key >= lit38 t59~ :=)
    (t59~ lit37addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (lit3 stpushi)
    (lit3 :init_gui !)
    (reset-reg)
    (:sdl_free_all_gadgets !)
    (reset-reg)
    (lit32 lit39addr :check !)
    (discard3~ stpopi)
    (reset-reg)
    (lit32 stpushi)
    (lit32 :sdl_delay !)
    (reset-reg)
    (:sdl_quit !)
    (reset-reg)
    (lit40 :print_s !)
    (:print_n !)
    (l2v_sdlmod :free_mod !)
    (zero :free_mod !)
    (zero :exit !)
(funcend)

(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (lit42 :print_s !)
    (set string 4096 sb2~ "")
    (sb2~ label~ :string_copy !)
    (sb2~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (lit43 :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)

(l2v_sdl_get_pixelcolor func)
    #var ~ l2v_sdl_get_pixelcolor
    (set int64 1 y~ 0)
    (set int64 1 x~ 0)
    (set int64 1 a~ 0)
    (set int64 1 r~ 0)
    (set int64 1 g~ 0)
    (set int64 1 b~ 0)
    (y~ stpopi)
    (x~ stpopi)
    (x~ y~ :sdl_get_pixelcolor !)
    (a~ stpopi)
    (r~ stpopi)
    (g~ stpopi)
    (b~ stpopi)
    (reset-reg)
    (a~ l2v_sdl_pixel_a :=)
    (r~ l2v_sdl_pixel_r :=)
    (g~ l2v_sdl_pixel_g :=)
    (b~ l2v_sdl_pixel_b :=)
    (r~ stpushi)
(funcend)

(l2v_sdl_get_mouse_state func)
    #var ~ l2v_sdl_get_mouse_state
    (set int64 1 x~ 0)
    (set int64 1 y~ 0)
    (set int64 1 left~ 0)
    (set int64 1 middle~ 0)
    (set int64 1 right~ 0)
    (:sdl_get_mouse_state !)
    (right~ stpopi)
    (middle~ stpopi)
    (left~ stpopi)
    (y~ stpopi)
    (x~ stpopi)
    (reset-reg)
    (x~ l2v_sdl_mouse_x :=)
    (y~ l2v_sdl_mouse_y :=)
    (left~ l2v_sdl_mouse_left :=)
    (middle~ l2v_sdl_mouse_middle :=)
    (right~ l2v_sdl_mouse_right :=)
    (x~ stpushi)
(funcend)

(l2v_sdl_get_joystick_info func)
    #var ~ l2v_sdl_get_joystick_info
    (set int64 1 name~ 0)
    (set int64 1 axis~ 0)
    (set int64 1 buttons~ 0)
    (name~ stpopi)
    (name~ :sdl_get_joystick_info !)
    (axis~ stpopi)
    (buttons~ stpopi)
    (reset-reg)
    (axis~ l2v_sdl_joy_axis :=)
    (buttons~ l2v_sdl_joy_buttons :=)
    (axis~ stpushi)
(funcend)

(l2v_sdl_get_gadget_x2y2 func)
    #var ~ l2v_sdl_get_gadget_x2y2
    (set int64 1 gadget~ 0)
    (set int64 1 x2~ 0)
    (set int64 1 y2~ 0)
    (gadget~ stpopi)
    (gadget~ :get_gadget_x2y2 !)
    (x2~ stpopi)
    (y2~ stpopi)
    (reset-reg)
    (x2~ l2v_sdl_gadget_x2 :=)
    (y2~ l2v_sdl_gadget_y2 :=)
    (x2~ stpushi)
(funcend)

(l2v_sdl_gadget_event func)
    #var ~ l2v_sdl_gadget_event
    (set int64 1 text~ 0)
    (set int64 1 gadget~ 0)
    (set int64 1 value~ 0)
    (set int64 1 status~ 0)
    (text~ stpopi)
    (text~ :gadget_event !)
    (status~ stpopi)
    (value~ stpopi)
    (gadget~ stpopi)
    (reset-reg)
    (value~ l2v_sdl_gadget_value :=)
    (status~ l2v_sdl_gadget_status :=)
    (gadget~ stpushi)
(funcend)


