(:main jmp)
#include <intr-func.l1h>

(main func)
    #var ~ main
    (set int64 1 zero 0)
    (zero :string_init !)
    (set string s lit3 "add")
    (set int64 1 lit4 1)
    (set string s lit5 "sub")
    (set string s lit6 "mul")
    (set string s lit7 "div")
    (set string s lit8 "mod")
    (set int64 1 lit9 17)
    (set int64 1 lit10 5)
    (set int64 1 lit11 2)
    (set string s lit12 "neg")
    (set string s lit13 "nested")
    (set string s lit14 "empty +")
    (set string s lit15 "empty -")
    (set string s lit16 "1+")
    (set string s lit17 "1-")
    (set string s lit18 "max")
    (set string s lit19 "min")
    (set string s lit20 "abs")
    (set string s lit21 "evenp")
    (set string s lit22 "oddp")
    (set string s lit23 "zerop")
    (set string s lit24 "compare")
    (set string s lit25 "chain <")
    (set string s lit26 "arithmetic done")
    (set string s lit28 "ok   ")
    (set string s lit29 "FAIL ")
    (lit4 lit3addr :check !)
    (set int64 1 discard1~ 0)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit5addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit6addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit7addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (set int64 1 t2~ 0)
    (lit9 % lit10 t2~ :=)
    (set int64 1 t3~ 0)
    (t2~ == lit11 t3~ :=)
    (t3~ lit8addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit12addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit13addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit14addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit15addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit16addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit17addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit18addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit19addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit20addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit21addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit22addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit23addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit24addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit4 lit25addr :check !)
    (discard1~ stpopi)
    (reset-reg)
    (lit26 :print_s !)
    (:print_n !)
    (zero :free_mod !)
    (zero :exit !)
(funcend)

(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (lit28 :print_s !)
    (set string 4096 sb2~ "")
    (sb2~ label~ :string_copy !)
    (sb2~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (lit29 :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)


#include <string.l1h>
