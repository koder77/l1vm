(funcend)

(l1_cons func)
    #var ~ l1_cons
    (set int64 1 a~ 0)
    (set int64 1 b~ 0)
    (set int64 1 idx~ 0)
    (set int64 1 off~ 0)
    (set int64 1 res~ 0)
    (set int64 1 next~ 0)
    (b~ stpopi)
    (a~ stpopi)
    (l1_hparr [ lit40 ] idx~ =)
    (idx~ lit16 + next~ :=)
    (idx~ lit9 * off~ :=)
    (idx~ lit9 * res~ :=)
    (lit16 res~ + res~ :=)
    (res~ stpushi)
    (a~ l1_cararr [ off~ ] =)
    (b~ l1_cdrarr [ off~ ] =)
    (next~ l1_hparr [ lit40 ] =)
(funcend)


