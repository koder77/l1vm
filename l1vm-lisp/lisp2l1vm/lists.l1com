(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (lit38 :print_s !)
    (set string 4096 sb2~ "")
    (sb2~ label~ :string_copy !)
    (sb2~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (lit39 :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)

(l1_consp func)
    #var ~ l1_consp
    (set int64 1 x~ 0)
    (set int64 1 tag~ 0)
    (set int64 1 res~ 0)
    (x~ stpopi)
    (x~ lit9 % tag~ :=)
    (tag~ lit16 == res~ :=)
    (res~ stpushi)
(funcend)

(l1_null func)
    #var ~ l1_null
    (set int64 1 x~ 0)
    (set int64 1 res~ 0)
    (x~ stpopi)
    (x~ lit6 == res~ :=)
    (res~ stpushi)
(funcend)

(l1_cdr func)
    #var ~ l1_cdr
    (set int64 1 x~ 0)
    (set int64 1 tag~ 0)
    (set int64 1 idx~ 0)
    (set int64 1 off~ 0)
    (set int64 1 flag~ 0)
    (set int64 1 res~ 0)
    (x~ stpopi)
    (x~ lit9 % tag~ :=)
    (tag~ lit16 == flag~ :=)
    (flag~ if+)
        (x~ lit9 / idx~ :=)
        (idx~ lit9 * off~ :=)
        (l1_cdrarr [ off~ ] res~ =)
        (res~ stpushi)
        (:L1CDREND jmp)
    (else)
        (lit6 stpushi)
    (endif)
    (:L1CDREND)
(funcend)

(l1_car func)
    #var ~ l1_car
    (set int64 1 x~ 0)
    (set int64 1 tag~ 0)
    (set int64 1 idx~ 0)
    (set int64 1 off~ 0)
    (set int64 1 flag~ 0)
    (set int64 1 res~ 0)
    (x~ stpopi)
    (x~ lit9 % tag~ :=)
    (tag~ lit16 == flag~ :=)
    (flag~ if+)
        (x~ lit9 / idx~ :=)
        (idx~ lit9 * off~ :=)
        (l1_cararr [ off~ ] res~ =)
        (res~ stpushi)
        (:L1CAREND jmp)
    (else)
        (lit6 stpushi)
    (endif)
    (:L1CAREND)
(funcend)

(l1_cons func)
    #var ~ l1_cons
    (set int64 1 a~ 0)
    (set int64 1 b~ 0)
    (set int64 1 idx~ 0)
    (set int64 1 off~ 0)
    (set int64 1 res~ 0)
    (set int64 1 next~ 0)
    (b~ stpopi)
    (a~ stpopi)
    (l1_hparr [ lit40 ] idx~ =)
    (idx~ lit16 + next~ :=)
    (idx~ lit9 * off~ :=)
    (idx~ lit9 * res~ :=)
    (lit16 res~ + res~ :=)
    (res~ stpushi)
    (a~ l1_cararr [ off~ ] =)
    (b~ l1_cdrarr [ off~ ] =)
    (next~ l1_hparr [ lit40 ] =)
(funcend)


