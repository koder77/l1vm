(:main jmp)
#include <intr-func.l1h>

(main func)
    #var ~ main
    (set int64 1 zero 0)
    (zero :string_init !)
    (set int64 1 lit3 0)
    (set int64 1 lit4 100000)
    (set int64 1 lit5 1)
    (set string s lit6 "count to 100000")
    (set string s lit7 "count done")
    (set string s lit9 "ok   ")
    (set string s lit10 "FAIL ")
    (set int64 1 i 0)
    (lit3 i :=)
    (:LOOP1)
    (set int64 1 t1~ 0)
    (i < lit4 t1~ :=)
    (set int64 1 t2~ 0)
    (t1~ zero == t2~ :=)
    (t2~ :LOOPE1 jmpi)
    (i + lit5 i :=)
    (:LOOP1 jmp)
    (:LOOPE1)
    (set int64 1 t3~ 0)
    (i == lit4 t3~ :=)
    (t3~ lit6addr :check !)
    (set int64 1 discard4~ 0)
    (discard4~ stpopi)
    (reset-reg)
    (lit7 :print_s !)
    (:print_n !)
    (zero :free_mod !)
    (zero :exit !)
(funcend)

(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (lit9 :print_s !)
    (set string 4096 sb2~ "")
    (sb2~ label~ :string_copy !)
    (sb2~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (lit10 :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)


#include <string.l1h>
