    (set int64 1 s~ 0)
    (set int64 1 v~ 0)
    (set int64 1 e~ 0)
    (set int64 1 f~ 0)
    (set int64 1 f2~ 0)
    (g~ stpopi)
    (h~ stpopi)
    (s~ stpopi)
    (h~ :l2v_file_valid !)
    (v~ stpopi)
    (reset-reg)
    (v~ if+)
        (h~ s~ :file_put_string !)
        (e~ stpopi)
        (reset-reg)
        ((e~ zero ==) f~ =)
        (f~ if+)
            ((g~ zero !=) f2~ =)
            (f2~ if+)
                (h~ lit44 :file_putc !)
                (e~ stpopi)
                (reset-reg)
                ((e~ zero ==) f~ =)
                (f~ if+)
                    (s~ stpushi)
                (else)
                    (zero stpushi)
                (endif)
            (else)
                (s~ stpushi)
            (endif)
        (else)
            (zero stpushi)
        (endif)
    (else)
        (zero stpushi)
    (endif)
(funcend)

(l2v_file_write_char func)
    #var ~ l2v_file_write_char
    (set int64 1 h~ 0)
    (set int64 1 c~ 0)
    (set byte 1 cb~ 0)
    (set int64 1 v~ 0)
    (set int64 1 e~ 0)
    (set int64 1 f~ 0)
    (h~ stpopi)
    (c~ stpopi)
    (h~ :l2v_file_valid !)
    (v~ stpopi)
    (reset-reg)
    (v~ if+)
        (c~ stpushb)
        (cb~ stpopb)
        (h~ cb~ :file_putc !)
        (e~ stpopi)
        (reset-reg)
        ((e~ zero ==) f~ =)
        (f~ if+)
            (c~ stpushi)
        (else)
            (zero stpushi)
        (endif)
    (else)
        (zero stpushi)
    (endif)
(funcend)

(l2v_file_flush func)
    #var ~ l2v_file_flush
    (set int64 1 e~ 0)
    (set int64 1 f~ 0)
    (:file_flush !)
    (e~ stpopi)
    (reset-reg)
    ((e~ zero ==) f~ =)
    (f~ if+)
        (lit6 stpushi)
    (else)
        (zero stpushi)
    (endif)
(funcend)


