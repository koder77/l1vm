    (set byte 1 cb~ 0)
    (set int64 1 v~ 0)
    (set int64 1 e~ 0)
    (set int64 1 f~ 0)
    (h~ stpopi)
    (c~ stpopi)
    (h~ :l2v_file_valid !)
    (v~ stpopi)
    (reset-reg)
    (v~ if+)
        (c~ stpushb)
        (cb~ stpopb)
        (h~ cb~ :file_putc !)
        (e~ stpopi)
        (reset-reg)
        ((e~ zero ==) f~ =)
        (f~ if+)
            (c~ stpushi)
        (else)
            (zero stpushi)
        (endif)
    (else)
        (zero stpushi)
    (endif)
(funcend)

(l2v_file_flush func)
    #var ~ l2v_file_flush
    (set int64 1 e~ 0)
    (set int64 1 f~ 0)
    (:file_flush !)
    (e~ stpopi)
    (reset-reg)
    ((e~ zero ==) f~ =)
    (f~ if+)
        (lit6 stpushi)
    (else)
        (zero stpushi)
    (endif)
(funcend)


