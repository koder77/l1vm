(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (set string 4096 sb2~ "")
