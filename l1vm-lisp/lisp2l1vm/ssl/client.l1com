(:main jmp)
#include <intr-func.l1h>

(main func)
    #var ~ main
    (set int64 1 zero 0)
    (set int64 1 l2v_netmod 2)
    (set int64 1 netmax~ 8)
    (set int64 8 l2v_sockkind 0)
    (zero :string_init !)
    (set int64 1 netinit~ 0)
    (l2v_netmod netmax~ :net_init !)
    (netinit~ stpopi)
    (reset-reg)
    (set string s lit1 "NIL")
    (set string s lit2 "T")
    (set int64 1 lit3 30012)
    (set string s lit4 "127.0.0.1")
    (set int64 1 lit5 -1)
    (set int64 1 lit6 5)
    (set int64 1 lit7 8)
    (set string s lit8 "open ssl client")
    (set int64 1 lit9 4)
    (set string s lit10 "ssl client is socket")
    (set string s lit11 "ssl read-line")
    (set int64 1 lit12 4095)
    (set string s lit13 "alpha")
    (set string s lit14 "ssl write-line")
    (set string s lit15 "beta")
    (set int64 1 lit16 0)
    (set string s lit17 "ssl read-char")
    (set int64 1 lit18 67)
    (set string s lit19 "ssl write-char")
    (set int64 1 lit20 66)
    (set string s lit21 "close ssl client")
    (set string s lit22 "closed is not ssl socket")
    (set string s lit23 "ssl client done")
    (set string s lit24 "PASS")
    (set string s lit25 "ok   ")
    (set string s lit26 "FAIL ")
    (set int64 1 lit27 1)
    (set int64 1 lit28 2)
    (set int64 1 lit29 3)
    (set int64 1 lit30 6)
    (set int64 1 port 0)
    (lit3 port :=)
    (set int64 1 host 0)
    (lit4addr host :=)
    (set int64 1 t1~ 0)
    (set int64 1 t2~ 0)
    (set int64 1 t3~ 0)
    (set int64 1 t4~ 0)
    (set int64 1 t5~ 0)
    (set int64 1 t6~ 0)
    (host port :open_client_socket_ssl !)
    (t1~ stpopi)
    (t2~ stpopi)
    (reset-reg)
    ((t1~ zero ==) t3~ =)
    ((t2~ zero <) t4~ =)
    (t3~ if+)
        (t4~ if+)
            (lit5 stpushi)
        (else)
            (t2~ lit7 * t6~ :=)
            (lit6 l2v_sockkind [ t6~ ] =)
            (t2~ stpushi)
        (endif)
    (else)
        (lit5 stpushi)
    (endif)
    (t5~ stpopi)
    (reset-reg)
    (set int64 1 client 0)
    (t5~ client :=)
    (client :l2v_socket_kind !)
    (set int64 1 t7~ 0)
    (t7~ stpopi)
    (reset-reg)
    (set int64 1 t8~ 0)
    ((t7~ lit9 >=) t8~ =)
    (t8~ lit8addr :check !)
    (set int64 1 t9~ 0)
    (t9~ stpopi)
    (reset-reg)
    (client :l2v_socket_kind !)
    (set int64 1 t10~ 0)
    (t10~ stpopi)
    (reset-reg)
    (set int64 1 t11~ 0)
    ((t10~ zero >) t11~ =)
    (t11~ lit10addr :check !)
    (set int64 1 t12~ 0)
    (t12~ stpopi)
    (reset-reg)
    (set string 4096 sb13~ "")
    (set int64 1 Pstr14~ 0)
    (sb13~ Pstr14~ pointer)
    (set int64 1 t15~ 0)
    (client Pstr14~ lit12 :socket_read_string !)
    (t15~ stpopi)
    (reset-reg)
    (set int64 1 t16~ 0)
    (set string 4096 sb17~ "")
    (sb17~ Pstr14~ :string_copy !)
    (set string 4096 sb18~ "")
    (sb18~ lit13addr :string_copy !)
    (set int64 1 t19~ 0)
    (sb17~ sb18~ :string_compare !)
    (t19~ stpopi)
    (reset-reg)
    (t19~ zero == t16~ :=)
    (t16~ lit11addr :check !)
    (set int64 1 t20~ 0)
    (t20~ stpopi)
    (reset-reg)
    (set int64 1 t21~ 0)
    (client lit15addr :socket_write_string !)
    (t21~ stpopi)
    (reset-reg)
    (set int64 1 t22~ 0)
    (t21~ == lit16 t22~ :=)
    (t22~ lit14addr :check !)
    (set int64 1 t23~ 0)
    (t23~ stpopi)
    (reset-reg)
    (set int64 1 t24~ 0)
    (set int64 1 t25~ 0)
    (set int64 1 t26~ 0)
    (set int64 1 t27~ 0)
    (client :socket_read_byte !)
    (t24~ stpopi)
    (t25~ stpopi)
    (reset-reg)
    ((t24~ zero ==) t26~ =)
    (t26~ if+)
        (t25~ stpushi)
    (else)
        (lit5 stpushi)
    (endif)
    (t27~ stpopi)
    (reset-reg)
    (set int64 1 t28~ 0)
    (t27~ == lit18 t28~ :=)
    (t28~ lit17addr :check !)
    (set int64 1 t29~ 0)
    (t29~ stpopi)
    (reset-reg)
    (set int64 1 t30~ 0)
    (client lit20 :socket_write_byte !)
    (t30~ stpopi)
    (reset-reg)
    (set int64 1 t31~ 0)
    (t30~ == lit16 t31~ :=)
    (t31~ lit19addr :check !)
    (set int64 1 t32~ 0)
    (t32~ stpopi)
    (reset-reg)
    (set int64 1 t33~ 0)
    (client :l2v_close_socket !)
    (t33~ stpopi)
    (reset-reg)
    (set int64 1 t34~ 0)
    (t33~ == lit16 t34~ :=)
    (t34~ lit21addr :check !)
    (set int64 1 t35~ 0)
    (t35~ stpopi)
    (reset-reg)
    (client :l2v_socket_kind !)
    (set int64 1 t36~ 0)
    (t36~ stpopi)
    (reset-reg)
    (set int64 1 t37~ 0)
    ((t36~ lit9 >=) t37~ =)
    (set int64 1 t38~ 0)
    (t37~ zero == t38~ :=)
    (t38~ lit22addr :check !)
    (set int64 1 t39~ 0)
    (t39~ stpopi)
    (reset-reg)
    (set string 4096 sb40~ "")
    (sb40~ lit23addr :string_copy !)
    (sb40~ :print_s !)
    (:print_n !)
    (zero :free_mod !)
    (l2v_netmod :free_mod !)
    (zero :exit !)
(funcend)

(check func)
    #var ~ check
    (set int64 1 label~ 0)
    (label~ stpopi)
    (set int64 1 ok~ 0)
    (ok~ stpopi)
    (set int64 1 t1~ 0)
    (ok~ if+)
    (set string 4096 sb2~ "")
    (sb2~ lit25addr :string_copy !)
    (sb2~ :print_s !)
    (set string 4096 sb3~ "")
    (sb3~ label~ :string_copy !)
    (sb3~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (else)
    (set string 4096 sb4~ "")
    (sb4~ lit26addr :string_copy !)
    (sb4~ :print_s !)
    (set string 4096 sb5~ "")
    (sb5~ label~ :string_copy !)
    (sb5~ :print_s !)
    (:print_n !)
    (zero t1~ :=)
    (endif)
    (t1~ stpushi)
(funcend)

(l2v_socket_kind func)
    #var ~ l2v_socket_kind
    (set int64 1 h~ 0)
    (set int64 1 k~ 0)
    (set int64 1 f~ 0)
    (set int64 1 off~ 0)
    (h~ stpopi)
    ((h~ zero <) f~ =)
    (f~ if+)
        (zero stpushi)
    (else)
        ((h~ lit7 >=) f~ =)
        (f~ if+)
            (zero stpushi)
        (else)
            (h~ lit7 * off~ :=)
            (l2v_sockkind [ off~ ] k~ =)
            (k~ stpushi)
        (endif)
    (endif)
(funcend)

(l2v_close_socket func)
    #var ~ l2v_close_socket
    (set int64 1 h~ 0)
    (set int64 1 k~ 0)
    (set int64 1 s~ 0)
    (set int64 1 f~ 0)
    (set int64 1 o~ 0)
    (h~ stpopi)
    (h~ :l2v_socket_kind !)
    (k~ stpopi)
    (reset-reg)
    ((k~ zero ==) f~ =)
    (f~ if+)
        (lit5 stpushi)
    (else)
        ((k~ lit27 ==) f~ =)
        (f~ if+)
            (h~ :close_server_socket !)
            (s~ stpopi)
            (reset-reg)
            (h~ lit7 * o~ :=)
            (zero l2v_sockkind [ o~ ] =)
            (s~ stpushi)
        (else)
            ((k~ lit28 ==) f~ =)
            (f~ if+)
                (h~ :close_client_socket !)
                (s~ stpopi)
                (reset-reg)
                (h~ lit7 * o~ :=)
                (zero l2v_sockkind [ o~ ] =)
                (s~ stpushi)
            (else)
                ((k~ lit29 ==) f~ =)
                (f~ if+)
                    (h~ :close_accept_server !)
                    (s~ stpopi)
                    (reset-reg)
                    (h~ lit7 * o~ :=)
                    (zero l2v_sockkind [ o~ ] =)
                    (s~ stpushi)
                (else)
                    ((k~ lit9 ==) f~ =)
                    (f~ if+)
                        (h~ :close_server_socket_ssl !)
                        (s~ stpopi)
                        (reset-reg)
                        (h~ lit7 * o~ :=)
                        (zero l2v_sockkind [ o~ ] =)
                        (s~ stpushi)
                    (else)
                        ((k~ lit6 ==) f~ =)
                        (f~ if+)
                            (h~ :close_client_socket_ssl !)
                            (s~ stpopi)
                            (reset-reg)
                            (h~ lit7 * o~ :=)
                            (zero l2v_sockkind [ o~ ] =)
                            (s~ stpushi)
                        (else)
                            ((k~ lit30 ==) f~ =)
                            (f~ if+)
                                (h~ :close_accept_server_ssl !)
                                (s~ stpopi)
                                (reset-reg)
                                (h~ lit7 * o~ :=)
                                (zero l2v_sockkind [ o~ ] =)
                                (s~ stpushi)
                            (else)
                                (lit5 stpushi)
                            (endif)
                        (endif)
                    (endif)
                (endif)
            (endif)
        (endif)
    (endif)
(funcend)


#include <string.l1h>

#include <net-lib.l1h>
