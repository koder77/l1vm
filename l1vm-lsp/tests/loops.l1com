// loops sample - do-while and for loop in real Brackets syntax
// modeled after hello-while.l1com and hello-for.l1com
#include <intr.l1h>
(main func)
	(set int64 1 zero 0)
	(set int64 1 one 1)
	(set int64 1 loop 0)
	(set int64 1 maxloop 10)
	(set int64 1 f 0)
	(set string s hello "Hello world!")
	// do-while loop
	(zero loop =)
	(do)
		(hello :print_s !)
		(:print_n !)
		((loop one +) loop =)
	(((loop maxloop <) f =) f while)
	// for loop
	(zero loop =)
	(for-loop)
	(((loop maxloop <) f =) f for)
		(hello :print_s !)
		(:print_n !)
		((loop one +) loop =)
	(next)
	(zero :exit !)
(funcend)
